tr).split(\\\",\\\"):\\n        part = part.strip()\\n        if part.isdigit():\\n            failed.append(int(part))\\n\\n    # 已成功的天按 day_no 建表\\n    merged = {}\\n    for d in valid_days:\\n        if isinstance(d, dict) and d.get(\\\"day_no\\\") is not None:\\n            try:\\n                merged[int(d[\\\"day_no\\\"])] = d\\n            except Exception:\\n                pass\\n\\n    # 重生成结果按顺序对应失败天号，强制修正 day_no（不信 LLM 序号）\\n    for idx, item in enumerate(retry_list):\\n        if idx >= len(failed):\\n            break\\n        dn = failed[idx]\\n        obj = item\\n        if isinstance(item, str):\\n            try:\\n                obj = json.loads(item)\\n            except Exception:\\n                obj = None\\n        if not isinstance(obj, dict):\\n            continue\\n        # 解包 day_recipe_json 包装结构（兼容 200105 的 extract_raw_from_item）\\n        if \\\"day_recipe_json\\\" in obj and obj.get(\\\"day_recipe_json\\\") not in (None, \\\"\\\"):\\n            try:\\n                inner = obj[\\\"day_recipe_json\\\"]\\n                if isinstance(inner, str):\\n                    inner = json.loads(inner)\\n                if isinstance(inner, dict):\\n                    obj = inner\\n            except Exception:\\n                pass\\n        # 检测兜底/失败标记\\n        raw_text = str(item)\\n        if any(m in raw_text for m in [\\\"生成失败\\\", \\\"请重新生成\\\", \\\"默认兜底\\\"]):\\n            continue\\n        # isSuccess=false 判失败\\n        if obj.get(\\\"isSuccess\\\") is False:\\n            continue\\n        meals = obj.get(\\\"meals\\\")\\n        if not isinstance(meals, dict):\\n            continue        # B/L/D 非空校验（同 200105）\\n        if not meals.get(\\\"BREAKFAST\\\") or not meals.get(\\\"LUNCH\\\") or not meals.get(\\\"DINNER\\\"):\\n            continue\\n        # 强制修正 day_no\\n        obj[\\\"day_no\\\"] = dn\\n        # dayLabel 交叉校验：正则提取数字与 day_no 比对，不一致强制 Day{dn}\\n        day_label = obj.get(\\\"dayLabel\\\") or obj.get(\\\"day_label\\\") or \\\"\\\"\\n        m = re.search(r\\\"\\\\d+\\\", str(day_label))\\n        if m and int(m.group()) != dn:\\n            obj[\\\"dayLabel\\\"] = f\\\"Day{dn}\\\"\\n        elif not day_label:\\n            obj[\\\"dayLabel\\\"] = f\\\"Day{dn}\\\"\\n        merged[dn] = obj\\n\\n    # 按 day_no 排序\\n    days = sorted(merged.values(), key=lambda x: int(x.get(\\\"day_no\\\", 0)))\\n\\n    # 校验 28 天齐全\\n    present = {int(d.get(\\\"day_no\\\", 0)) for d in days if isinstance(d, dict)}\\n    missing = [str(i) for i in range(1, 29) if i not in present]\\n    ok = len(present) == 28 and not missing\\n    status = \\\"SUCCESS\\\" if ok else \\\"FAILED\\\"\\n\\n    # 合并错误：原始错误 + 重试后仍缺失的天\\n    if not ok:\\n        errors_src.append({\\\"index\\\": None, \\\"error\\\": \\\"重试后仍缺失: \\\" + \\\",\\\".join(missing)})\\n\\n    return {\\n        \\\"status\\\": status,\\n        \\\"is_success\\\": ok,\\n        \\\"valid_days\\\": {\\\"items\\\": days},\\n        \\\"failed_days\\\": \\\",\\\".join(missing),\\n        \\\"errors\\\": {\\\"items\\\": errors_src},\\n        \\\"completed_days\\\": str(len(present)),\\n        \\\"total_days\\\": \\\"28\\\",\\n        \\\"debug_logs\\\": {\\\"items\\\": [{\\\"step\\\": \\\"merged\\\", \\\"info\\\": {\\\"present\\\": sorted(present), \\\"missing\\\": missing, \\\"retry_count\\\": len(retry_list)}}]},\\n    }\\n\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"status\"},{\"type\":\"object\",\"name\":\"valid_days\",\"schema\":[]},{\"type\":\"string\",\"name\":\"failed_days\"},{\"type\":\"object\",\"name\":\"errors\",\"schema\":[]},{\"type\":\"string\",\"name\":\"completed_days\"},{\"type\":\"string\",\"name\":\"total_days\"},{\"type\":\"boolean\",\"name\":\"is_success\"},{\"type\":\"object\",\"name\":\"debug_logs\",\"schema\":[]}]}},{\"id\":\"200105c\",\"type\":\"8\",\"meta\":{\"position\":{\"x\":8460,\"y\":527.9}},\"data\":{