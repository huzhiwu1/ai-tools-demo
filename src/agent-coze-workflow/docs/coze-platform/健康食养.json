"{\"nodes\":[{\"id\":\"100001\",\"type\":\"1\",\"meta\":{\"position\":{\"x\":180,\"y\":51.35000000000002}},\"data\":{\"nodeMeta\":{\"description\":\"工作流的起始节点，用于设定启动工作流需要的信息\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Start-v2.jpg\",\"subTitle\":\"\",\"title\":\"开始\"},\"outputs\":[{\"type\":\"list\",\"name\":\"examination_report\",\"schema\":{\"type\":\"string\"},\"required\":false},{\"type\":\"string\",\"name\":\"questionnaireData\",\"required\":true},{\"type\":\"string\",\"name\":\"personal_requirement\",\"required\":false,\"defaultValue\":\"无\"}],\"trigger_parameters\":[]}},{\"id\":\"900001\",\"type\":\"2\",\"meta\":{\"position\":{\"x\":9840,\"y\":434.9}},\"data\":{\"nodeMeta\":{\"description\":\"工作流的最终节点，用于返回工作流运行后的结果信息\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-End-v2.jpg\",\"subTitle\":\"\",\"title\":\"结束\"},\"inputs\":{\"terminatePlan\":\"returnVariables\",\"inputParameters\":[{\"name\":\"error_message\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"102441\",\"name\":\"Group1\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"result\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200106\",\"name\":\"result\"},\"rawMeta\":{\"type\":6}}}},{\"name\":\"total_days\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200106\",\"name\":\"total_days\"},\"rawMeta\":{\"type\":1}}}}]}}},{\"id\":\"182549\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":640,\"y\":37.00000000000002}},\"data\":{\"nodeMeta\":{\"title\":\"无图处理\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\"},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"examination_report\"},\"rawMeta\":{\"type\":99}}}}],\"code\":\"async def main(args: Args) -> Output:\\n    params = args.params\\n    images = params.get('images', [])\\n    \\n    # 如果列表有内容，原封不动输出；如果为空列表，输出空数组（与 list 输出声明一致，防类型不匹配）\\n    if images and len(images) > 0:\\n        result = images\\n    else:\\n        result = None\\n    \\n    ret: Output = {\\n        \\\"result\\\": result\\n    }\\n    \\n    return ret\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"list\",\"name\":\"result\",\"schema\":{\"type\":\"string\"}}]}},{\"id\":\"141264\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":1100,\"y\":2.842170943040401e-14}},\"data\":{\"nodeMeta\":{\"title\":\"输出是否接待\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"ques_info\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"questionnaireData\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\",\"assistType\":2},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"182549\",\"name\":\"result\"},\"rawMeta\":{\"type\":104,\"isVision\":true}}}}],\"llmParam\":[{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.2\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTokens\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"512\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"topP\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.7\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"responseFormat\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"2\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"modleName\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"Doubao-Seed-1.8\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"modelType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"180\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"balance\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"supportThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"enableThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"apiType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"1\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"学生体检报告：{{images}}\\n学生问卷信息：{{ques_info}}\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"enableChatHistory\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":false,\"rawMeta\":{\"type\":3}}}},{\"name\":\"chatHistoryRound\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"3\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"systemPrompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"# 角色：\\n你是一名专业的金牌诊断师，非常擅长根据用户的体检报告以及问卷信息，诊断学生是否需要进行接待，一遍后续动作。\\n\\n## 目标：\\n我会给你提供``不接待学生范围``，你需要根据学生上传的体检报告、信息调查问卷，基于``不接待学生范围``，判断学生是否处于``不接待学生范围``中，并按照规则输出相应内容\\n\\n##  不接待学生范围\\n### 年龄维度\\n#### 不接待：\\n13 周岁及以下（含 13 岁）；85 周岁及以上（含 85 岁）\\n#### 原因：\\n13 岁以下生长发育关键期，营养方案适配性不足；85 岁以上多伴随基础病，身体耐受度低\\n#### 特殊可接待：\\n85 岁以上问卷情况好且评估胃肠功能可接待\\n#### 风险：\\n青少年营养失衡；老年人加重基础病、跌倒意外\\n------------------------------------------------------------------------------\\n### 心血管系统\\n#### 不接待：\\n恶性高血压（血压≥180/120mmHg 经医用后）；主动脉夹层 A 型术后心功能不全（LVEF＜50%）；脑梗 / 脑中风病史＜2 年；持续性 / 症状性房颤（影响正常生活）\\n#### 原因：\\n血压失控、心功能差、神经功能未稳定、易形成血栓\\n#### 特殊可接待：\\n一次性腔隙脑梗可接待\\n#### 风险：\\n心脑血管意外、心衰、血栓脱落引发脑梗 / 肺栓塞\\n------------------------------------------------------------------------------\\n### 内分泌系统\\n#### 不接待：\\n糖尿病足患者；甲状腺结节 5A 级及以上（含 5A）\\n#### 原因：\\n糖尿病足需外科治疗；5A 结节恶变风险高\\n#### 特殊可接待：\\n甲状腺癌术后 3 - 6 个月且吞咽无问题可接待\\n#### 风险：\\n糖尿病足感染扩散；甲状腺结节延误诊治\\n------------------------------------------------------------------------------\\n### 消化与肝肾系统\\n#### 不接待：\\n肝硬化 / 肝功能衰竭；慢性肾衰竭 3 期及以上；尿毒症；器官移植术后；萎缩性胃炎肠上皮化生；肠癌（结直肠癌 + 过度消瘦 + BMI＜18.5，三者同时满足）\\n#### 原因：\\n肝肾功能失代偿；需透析 / 抗排异治疗；胃粘膜修复未稳定\\n#### 特殊可接待：\\n肝硬化初期且蛋白代谢指标正常可接待；尿毒症未透析可接待；肠癌术后 6 个月以上恢复食负可接待\\n#### 风险：\\n肝性脑病、高钾血症；透析不充分多器官损伤；移植器官排异\\n------------------------------------------------------------------------------\\n### 呼吸系统\\n#### 不接待：\\n慢阻肺（COPD）急性发作期；肺心病患者\\n#### 原因：\\n呼吸功能严重受损，活动易诱发心衰\\n#### 风险：\\n呼吸衰竭、急性心衰\\n------------------------------------------------------------------------------\\n### 血液与免疫系统\\n#### 不接待：\\n白血病；再生障碍性贫血\\n#### 原因：\\n需专业医疗干预（化疗、骨髓移植）\\n#### 风险：\\n病情进展、大出血、重症感染\\n------------------------------------------------------------------------------\\n### 外科与肿瘤史\\n#### 不接待：\\n恶性肿瘤术后 3 年内；胃窦粘膜切除术后＜3 年；胰腺 & 肠癌晚期\\n#### 原因：\\n肿瘤康复关键期；胃粘膜未稳定\\n#### 风险：\\n肿瘤转移；胃粘膜损伤加重\\n------------------------------------------------------------------------------\\n### 特殊情况\\n#### 不接待：\\n孕妇；精神分裂症患者；脑萎患者；帕金森病（症状严重 / 需手术 / 日常活动受限）\\n#### 原因：\\n影响胎儿发育；认知 / 配合度差；脑组织不可逆损伤\\n#### 风险：\\n胎儿畸形、流产；情绪暴力 / 自伤；生活无法自理；跌倒骨折\\n\\n## 限制：\\n- 特别注意，要特别关注用户的调查信息问卷，如“家族遗传史”、“服用药物”等，要理解精准到位，不要无中生有，不要臆想服用药物等。\\n- 学生本人的自身病史与家族病史无关，不可由于家族病史（比如信息问卷显示家族成员高血压）而默认学生也有相应疾病，不可随意臆想学生有高血压！学生的病史最重要是参考信息问卷中的``基础疾病``，以``基础疾病``为准，不可臆想，不可无中生有。\\n- **学生的所有病症以体检报告和问卷信息为准，对于没有提到的病症一律默认是没有，不可出现类似【是否患有高血压】这样的情况，没出现就是没有。**\\n- 特别注意，当学生的信息问卷中，``基础疾病``的一项填的是``其他``时，则默认无问题，忽略此项。\\n\\n## 输出格式：\\n按照以下json格式输出，确保输出内容可以被python的json.loads()解析：\\n{\\n    \\\"is_reception\\\": bool类型，表示是否接待，true代表接待，false代表不接待\\n    \\\"reason\\\": str类型，接待or不接待的原因\\n}\\n\\n## 输出示例：\\n### 示例一：\\n{\\n    \\\"is_reception\\\": false\\n    \\\"reason\\\": \\\"同学患有白血病，不接待。\\\"\\n}\\n### 示例二：\\n{\\n    \\\"is_reception\\\": false\\n    \\\"reason\\\": \\\"同学是糖尿病足患者，不接待。\\\"\\n}\\n### 示例三：\\n{\\n    \\\"is_reception\\\": true\\n    \\\"reason\\\": \\\"同学不在不接待范围内，可接待\\\"\\n}\\n\",\"rawMeta\":{\"type\":1}}}}],\"settingOnError\":{\"switch\":true,\"dataOnErr\":\"{\\n    \\\"is_reception\\\": false,\\n    \\\"reason\\\": \\\"\\\",\\n    \\\"reasoning_content\\\": \\\"\\\"\\n}\",\"processType\":3,\"timeoutMs\":120000,\"singleTimeoutMs\":0,\"retryTimes\":1,\"ext\":{\"backupLLmParam\":\"{\\\"temperature\\\":1,\\\"maxTokens\\\":16384,\\\"topP\\\":0.95,\\\"responseFormat\\\":2,\\\"modelName\\\":\\\"Doubao-Seed-2.0-lite\\\",\\\"modelType\\\":201,\\\"generationDiversity\\\":\\\"default_val\\\"}\"}}},\"outputs\":[{\"type\":\"boolean\",\"name\":\"is_reception\"},{\"type\":\"string\",\"name\":\"reason\"},{\"type\":\"string\",\"name\":\"reasoning_content\"},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"readonly\":true}],\"version\":\"3\"}},{\"id\":\"169974\",\"type\":\"8\",\"meta\":{\"position\":{\"x\":1560,\"y\":24.00000000000003}},\"data\":{\"nodeMeta\":{\"title\":\"判断是否接待\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Condition-v2.jpg\",\"description\":\"连接多个下游分支，若设定的条件成立则仅运行对应的分支，若均不成立则只运行“否则”分支\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"选择器\"},\"inputs\":{\"branches\":[{\"condition\":{\"logic\":2,\"conditions\":[{\"operator\":11,\"left\":{\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"141264\",\"name\":\"is_reception\"}}}}}]}}]}}},{\"id\":\"1930343\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":2020,\"y\":284.70000000000005}},\"data\":{\"nodeMeta\":{\"title\":\"体检报告解读生成\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"ques_info\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"questionnaireData\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\",\"assistType\":2},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"182549\",\"name\":\"result\"},\"rawMeta\":{\"type\":104,\"isVision\":true}}}}],\"llmParam\":[{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.3\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTokens\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"4096\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"topP\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.7\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"responseFormat\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"2\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"modleName\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"Doubao-Seed-1.8\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"modelType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"180\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"default_val\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"supportThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"enableThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"apiType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"1\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"学生体检报告：{{images}}\\n学生问卷信息：{{ques_info}}\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"enableChatHistory\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":false,\"rawMeta\":{\"type\":3}}}},{\"name\":\"chatHistoryRound\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"3\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"systemPrompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"# 角色：\\n你是一名专业的金牌营养师，非常擅长分析学生的体检报告，并输出规范的分析报告。\\n\\n## 目标：\\n你需要根据学生上传的体检报告、信息调查问卷，输出学生的分析报告结果。\\n\\n## 限制：\\n- 思考过程以及回复都需要用中文，不要使用其他语言。\\n- 你输出的分析报告是面向同学的，所以你的整个思考过程以及回复中都不要用到“用户”这个字眼，若需要使用，则将“用户”替换成“同学”。\\n- 输出的分析报告中，不要出现任何指导用药或者药物关联饮食的建议或情况，包括用药配合，任何药物关联饮食都不要出现\\n- 特别注意，要特别关注用户的调查信息问卷，如“家族遗传史”、“服用药物”等，要理解精准到位，不要无中生有，不要臆想服用药物等。\\n- 学生本人的自身病史与家族病史无关，不可由于家族病史（比如信息问卷显示家族成员高血压）而默认学生也有相应疾病，不可随意臆想学生有高血压！学生的病史最重要是参考信息问卷中的``基础疾病``，以``基础疾病``为准，不可臆想，不可无中生有。\\n- **学生的所有病症以体检报告和问卷信息为准，对于没有提到的病症一律默认是没有，不可出现类似【是否患有高血压】这样的情况，没出现就是没有。**\\n- 特别注意，当学生的信息问卷中，``基础疾病``的一项填的是``其他``时，则默认无问题，忽略此项。\\n- **体检分析报告中不要出现任何【思考内容】，包括（亚麻籽油、深海鱼？用户无高尿酸，可用深海鱼如三文鱼？但用户饮食中每周肉鱼或虾 2 - 3 次，需要注意脂肪摄入，所以优质蛋白以低脂禽畜、豆类为主，深海鱼适量）等，你是一个真实营养师，不要有任何ai化和思考的内容**；\\n- 分析报告中不要有类似“分析报告”之类的大标题，输出结构要工整，不要在分析报告中出现任何食材建议或者食材清单（如示例食谱等），同时不要输出除了以下大点以外的标题或者内容；\\n- - 输出的分析报告需要分别以以下大点为标题，标题格式跟文本内容不要修改：\\n ### **核心健康问题**\\n ### **潜在风险因素**\\n ### **饮食及健康建议**\\n\\n## 特殊要求\\n- 体检分析报告中严禁出现任何疾病名称，包括【高血压】、【糖尿病】、【高尿酸】等相关疾病名称，这是红线，严禁出现！\\n- 根据用户体检报告，分析其中相关指标的升高、降低即可能得成因即可，并放在标题【核心健康问题】中，示例：\\n1. 目前（甘油三脂/总胆固醇/低密度脂蛋白升高）水平过高。其成因通常是多方面的，常见是由于不健康的饮食，缺乏活动，超重/肥胖等，血液中过多的脂类会沉积在受损的动脉血管壁内，形成脂质斑块（粥样硬化斑块），使动脉管壁变硬、管腔变窄。\\n2. 目前（糖化血红蛋白升高或空腹/餐后血糖升高）提示近期的血糖波动较高。血糖波动较高多数与体重超重肥胖导致胰岛素抵抗、高糖分饮食饮食相关，建议后续持续复查空腹血糖和餐后两小时血糖。\\n- 根据用户体检报告及问卷信息，分析学生生活中的运动饮食饮水的风险，并放在【潜在风险因素】中，示例：\\n1. 日常饮食应注意低脂低胆固醇饮食，避免食用动物油脂、肥肉等食物。\\n2. 日常应避免饮用高糖分饮料、限制如粥粉面饭、包子饼等精细主食的摄入，可用部分粗粮代替避免血糖波动升高。\\n- 根据用户体检报告及问卷信息，分析健康的饮食建议，并放在【饮食及健康建议】中。\\n\\n## 反面示例\\n1. 输出的分析报告中，不要出现任何指导用药或者药物关联饮食的建议或情况，包括用药配合，任何药物关联饮食都不要出现！反面示例如下：\\n### 示例一：\\n阿司匹林：避免饮酒，空腹服用时注意胃黏膜保护，可搭配护胃食物如山药、南瓜。\\n硝苯地平控释片加噻嗪片：避免葡萄柚汁，以免影响药效。\\n### 示例二：\\n瑞舒伐他汀建议晚间随餐服用，与富含膳食纤维的食物(如藜麦、燕麦)间隔1-2 小时，避免影响药物吸收。\\n### 示例三：\\n用药配合：避免食用可能影响药物代谢的食物（如葡萄柚，若服用硝苯地平需注意，因硝苯地平为钙通道阻滞剂，葡萄柚可能增强其作用），若有疑问咨询医生或药师。\\n以上示例均为反面案例，类似以上示例等建议不要出现在分析报告中。\\n\\n## 特殊说明：\\n1. **甲状腺结节 TI-RADS 3级以上患者需要减少或者不要含碘食物的摄入，例如海带、海草、海鱼虾等含碘食物，不要出现海产，所有海产都删除或者替换成别的食材**；\\n2. 胆石症（胆管结石、胆囊结石）者应控制用油量\\n3. 糖尿病同学不可以喝粥，首选全谷物、杂豆类和薯芋类作为主食。\\n4. **高尿酸人群需要禁食鱼虾蟹类、菌菇类等高嘌呤食物**\\n5. 糖尿病人群需要尽量吃干不吃稀（也就是不安排粥类），如果同时还有胃肠不好的情况，就吃杂粮软饭\\n6. 体检分析报告中不要出现**山竹、菠萝蜜、芒果、柚子**这些热带水果。\\n7.  高尿酸学员海鲜类规避：三文鱼、金枪鱼、鲳鱼、大黄鱼、青花鱼、多宝鱼、鲳鱼、海鲈鱼、鳕鱼、带鱼、鲫鱼、鲈鱼、虾仁、桂鱼、裙带菜、海带、海蜇；替换成：清蒸鸡腿肉、清蒸鸡胸肉、彩椒炒牛肉、菜蔬羊肉煲、萝卜炖瘦肉、清蒸鸽子肉、清蒸鸭脯 \\n8.  禁止出现用户已声明的禁忌，绝对避开用户声明的过敏原\\n9. 尿酸判断标准：\\n女性正常尿酸＜350mmol/L；\\n男性正常尿酸＜420mmol/L；\\n\\n## 输出规范\\n按照以下json格式输出，确保输出内容可以被python的json.loads()解析：\\n{\\n   \\\"core_health_issues\\\": \\\" ### **核心健康问题**：分析报告-指标的升高降低，及可能的成因\\\",\\n    \\\"risk_factors\\\": \\\" ### **潜在风险因素**：分析报告和问卷-生活中的运动饮食饮水的风险提示\\\",\\n    \\\"adjustment\\\": \\\"### **饮食及健康建议**：健康饮食建议\\\",\\n}\\n\\n## 输出示例\\n{\\n   \\\"core_health_issues\\\": \\\" ### **核心健康问题**：\\\\n xxxx\\\",\\n    \\\"risk_factors\\\": \\\" ### **潜在风险因素**：\\\\n xxxx\\\",\\n    \\\"adjustment\\\": \\\"### **饮食及健康建议**：\\\\n xxxx\\\",\\n}\\n\",\"rawMeta\":{\"type\":1}}}}],\"settingOnError\":{\"switch\":true,\"dataOnErr\":\"{\\n    \\\"core_health_issues\\\": \\\"\\\",\\n    \\\"risk_factors\\\": \\\"\\\",\\n    \\\"adjustment\\\": \\\"\\\",\\n    \\\"reasoning_content\\\": \\\"\\\"\\n}\",\"processType\":3,\"timeoutMs\":180000,\"singleTimeoutMs\":0,\"retryTimes\":1,\"ext\":{\"backupLLmParam\":\"{\\\"temperature\\\":1,\\\"maxTokens\\\":16384,\\\"topP\\\":0.95,\\\"responseFormat\\\":2,\\\"modelName\\\":\\\"Doubao-Seed-2.0-lite\\\",\\\"modelType\\\":201,\\\"generationDiversity\\\":\\\"default_val\\\"}\"}}},\"outputs\":[{\"type\":\"string\",\"name\":\"core_health_issues\"},{\"type\":\"string\",\"name\":\"risk_factors\"},{\"type\":\"string\",\"name\":\"adjustment\"},{\"type\":\"string\",\"name\":\"reasoning_content\"},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"readonly\":true}],\"version\":\"3\"}},{\"id\":\"105094\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":2480,\"y\":316.2}},\"data\":{\"nodeMeta\":{\"title\":\"解析体检报告分析\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"core_health_issues\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"1930343\",\"name\":\"core_health_issues\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"risk_factors\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"1930343\",\"name\":\"risk_factors\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"adjustment\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"1930343\",\"name\":\"adjustment\"},\"rawMeta\":{\"type\":1}}}}],\"code\":\"import re\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    core_health_issues = params['core_health_issues']    # 核心健康问题\\n    risk_factors = params['risk_factors']     # 潜在风险因素\\n    adjustment = params['adjustment']      # 饮食及健康建议\\n\\n    def norm(s):\\n        if not s:\\n            return \\\"\\\"\\n        return str(s).replace(\\\"\\\\\\\\n\\\", \\\"\\\\n\\\").strip()\\n\\n    RECIPE_NOTE = \\\"\\\"\\\"### **食谱说明**\\n1、每日确保20+种食材，融合粗细搭配、低钠高纤原则，并融入地中海饮食元素\\n2、油盐控制：全天用油≤25g（含亚麻籽油），盐＜4g（使用限盐勺）  \\n3、 主食搭配：每餐以粗粮为主，可根据肠道适应情况，适当增加精致米面 \\n4、 烹饪方式：蒸/煮/炖/凉拌为主，禁用煎炸，酱油替换为柠檬汁+香菇粉，或直接用魔法盐（盐30克+干香菇5克+干虾皮5克）\\n5、 备餐技巧：周末集中做好杂粮饭，每份75克分装盒冷冻  \\n     每日15分钟备餐：蔬菜洗净切配冷藏，肉类按份分装  \\n6、 外食替代方案：如遇聚餐，需提前联系班主任，班主任根据“211餐盘法”提供个性化应急配餐\\n7、高尿酸人群：禁用浓肉汤\\n8、隐形糖控制：所有奶制品/豆浆均为无糖\\\"\\\"\\\"\\n    DISCLAIMER = \\\"\\\"\\\"#### **以上解读与建议不能替代执业医师的诊疗意见不作为治疗手段，建议在医生和营养师指导下逐步调整饮食结构，以医院治疗为主，饮食为辅，定期监测。**\\n #### **祝您健康！**\\\"\\\"\\\"\\n\\n    # 拼接 report（保留原标题，供正则解析 + 下游 200101/200104A/B 兼容）\\n    report = \\\"\\\"\\n    for i in (core_health_issues, risk_factors, adjustment):\\n        if i:\\n            report += norm(i) + \\\"\\\\n\\\\n\\\"\\n    report += \\\"### **食谱说明**\\\\n\\\" + RECIPE_NOTE + \\\"\\\\n\\\\n\\\" + DISCLAIMER + \\\"\\\\n==========================================================================\\\"\\n\\n    # 照旧版 103783：从 report 文本正则提取 4 段，content 为纯内容\\n    items = parse_report_analysis(report)\\n\\n    ret: Output = {\\n        \\\"report\\\": report,\\n        \\\"reportAnalysis\\\": {\\\"items\\\": items},\\n    }\\n    return ret\\n\\n\\ndef parse_report_analysis(text: str) -> list:\\n    \\\"\\\"\\\"从 report 文本中提取章节，格式与旧版 103783 完全一致\\\"\\\"\\\"\\n    result = []\\n\\n    section_patterns = [\\n        (r'### \\\\*\\\\*核心健康问题\\\\*\\\\*[：:]?', '核心健康问题'),\\n        (r'### \\\\*\\\\*潜在风险因素\\\\*\\\\*[：:]?', '潜在风险因素'),\\n        (r'### \\\\*\\\\*饮食及健康建议\\\\*\\\\*[：:]?', '饮食及健康建议'),\\n        (r'### \\\\*\\\\*食谱说明\\\\*\\\\*', '食谱说明'),\\n    ]\\n\\n    sections_found = []\\n    for pattern, title in section_patterns:\\n        match = re.search(pattern, text)\\n        if match:\\n            sections_found.append({\\n                'title': title,\\n                'match_start': match.start(),\\n                'match_end': match.end(),\\n            })\\n\\n    sections_found.sort(key=lambda x: x['match_start'])\\n\\n    for i, section in enumerate(sections_found):\\n        start = section['match_end']\\n        if i + 1 < len(sections_found):\\n            end = sections_found[i + 1]['match_start']\\n        else:\\n            remaining_text = text[start:]\\n            separator_match = re.search(r'\\\\n=+\\\\n*$', remaining_text)\\n            if separator_match:\\n                end = start + separator_match.start()\\n            else:\\n                end = len(text)\\n\\n        content = text[start:end].strip()\\n        content = re.sub(r'^[：:]\\\\s*', '', content)\\n        content = content.strip()\\n\\n        if content:\\n            result.append({\\n                'title': section['title'],\\n                'content': content\\n            })\\n\\n    return result\\n\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"report\"},{\"type\":\"object\",\"name\":\"reportAnalysis\",\"schema\":[]}]}},{\"id\":\"127375\",\"type\":\"15\",\"meta\":{\"position\":{\"x\":8920,\"y\":37.00000000000002}},\"data\":{\"nodeMeta\":{\"title\":\"error_msg：不接待输出\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-StrConcat-v2.jpg\",\"description\":\"用于处理多个字符串类型变量的格式\",\"mainColor\":\"#3071F2\",\"subTitle\":\"文本处理\"},\"inputs\":{\"method\":\"concat\",\"inputParameters\":[{\"name\":\"String1\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"141264\",\"name\":\"reason\"},\"rawMeta\":{\"type\":1}}}}],\"concatParams\":[{\"name\":\"concatResult\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"{{String1}}\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"arrayItemConcatChar\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"，\",\"rawMeta\":{\"typ