x in (values or [])]).lower()\\n    return any(k.lower() in text for k in keywords)\\n\\n\\ndef get_season(month):\\n    if month in (3, 4, 5):\\n        return \\\"spring\\\"\\n    if month in (6, 7, 8):\\n        return \\\"summer\\\"\\n    if month in (9, 10, 11):\\n        return \\\"autumn\\\"\\n    return \\\"winter\\\"\\n\\n\\ndef get_region(province, city):\\n    south_cities = {\\\"苏州\\\", \\\"无锡\\\", \\\"常州\\\", \\\"镇江\\\", \\\"南京\\\", \\\"南通\\\", \\\"黄山\\\"}\\n    north_cities = {\\\"徐州\\\", \\\"连云港\\\", \\\"宿迁\\\", \\\"盐城\\\", \\\"淮安\\\", \\\"阜阳\\\"}\\n\\n    if city in south_cities:\\n        return \\\"south\\\"\\n    if city in north_cities:\\n        return \\\"north\\\"\\n\\n    south_provinces = {\\n        \\\"上海\\\", \\\"浙江\\\", \\\"福建\\\", \\\"江西\\\", \\\"湖南\\\", \\\"广东\\\",\\n        \\\"广西\\\", \\\"海南\\\", \\\"云南\\\", \\\"贵州\\\", \\\"四川\\\", \\\"重庆\\\", \\\"安徽\\\"\\n    }\\n    return \\\"south\\\" if province in south_provinces else \\\"north\\\"\\n\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    profile = params.get(\\\"profile_json\\\") or {}\\n\\n    # 兼容：profile_json 可能是 JSON 字符串，也可能是对象\\n    if isinstance(profile, str):\\n        try:\\n            profile = json.loads(profile)\\n        except Exception:\\n            profile = {}\\n    if not isinstance(profile, dict):\\n        profile = {}\\n\\n    bmi = num(profile.get(\\\"bmi\\\"))\\n    city = str(profile.get(\\\"city\\\") or \\\"\\\")\\n    province = str(profile.get(\\\"province\\\") or \\\"\\\")\\n\\n    gut_keywords = [\\n        \\\"长期腹泻\\\", \\\"腹泻\\\", \\\"腹胀\\\", \\\"消化不良\\\", \\\"肠胃较差\\\",\\n        \\\"胃肠功能差\\\", \\\"营养不良\\\", \\\"低蛋白\\\", \\\"体重持续下降\\\",\\n        \\\"明显消瘦\\\", \\\"进食困难\\\"\\n    ]\\n\\n    gut_flags = profile.get(\\\"gastrointestinal_flags\\\") or []\\n    weight_flags = profile.get(\\\"weight_loss_flags\\\") or []\\n    chronic = profile.get(\\\"chronic_conditions\\\") or []\\n    report_flags = profile.get(\\\"report_flags\\\") or []\\n\\n    gain_hit = (\\n        (0 < bmi < 18.5)\\n        or contains_any(gut_flags, gut_keywords)\\n        or contains_any(weight_flags, gut_keywords)\\n        or contains_any(report_flags, gut_keywords)\\n        or contains_any(chronic, [\\\"营养不良\\\", \\\"低蛋白\\\", \\\"消瘦\\\"])\\n    )\\n\\n    if gain_hit:\\n        recipe_set_id = \\\"gut_gain\\\"\\n        recipe_set_name = \\\"肠道较差人群·增重版\\\"\\n        region = \\\"\\\"\\n        season = \\\"\\\"\\n        route_reason = \\\"命中BMI偏低、消瘦、肠胃异常或营养不良条件，优先使用增重版。\\\"\\n    else:\\n        month = datetime.now().month\\n        season = get_season(month)\\n        region = get_region(province, city)\\n        recipe_set_id = f\\\"{season}_{region}\\\"\\n        recipe_set_name = f\\\"{season}版·{region}\\\"\\n        route_reason = f\\\"未命中增重条件，城市{city or '未填写'}按区域规则归类，当前为{month}月。\\\"\\n\\n    tags = []\\n    chronic_text = \\\" \\\".join([str(x) for x in chronic])\\n    allergy_text = \\\" \\\".join([str(x) for x in (profile.get(\\\"allergies\\\") or [])])\\n    taboo_text = \\\" \\\".join([str(x) for x in (profile.get(\\\"food_taboo\\\") or [])])\\n\\n    if \\\"高血压\\\" in chronic_text:\\n        tags.append(\\\"low_salt\\\")\\n    if \\\"糖尿病\\\" in chronic_text:\\n        tags.append(\\\"low_sugar\\\")\\n    if \\\"高血脂\\\" in chronic_text:\\n        tags.append(\\\"low_fat\\\")\\n    if \\\"高尿酸\\\" in chronic_text:\\n        tags.append(\\\"low_purine\\\")\\n    if any(x in allergy_text for x in [\\\"鱼\\\", \\\"虾\\\", \\\"海鲜\\\"]):\\n        tags.append(\\\"replace_seafood\\\")\\n    if taboo_text:\\n        tags.append(\\\"respect_food_taboo\\\")\\n\\n    return {\\n        \\\"recipe_set_id\\\": recipe_set_id,\\n        \\\"recipe_set_name\\\": recipe_set_name,\\n        \\\"region\\\": region,\\n        \\\"season\\\": season,\\n        \\\"route_reason\\\": route_reason,\\n        \\\"micro_adjustment_tags\\\": \\\",\\\".join(tags),\\n        \\\"rule_version\\\": \\\"v1\\\"\\n    }\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"recipe_set_id\"},{\"type\":\"string\",\"name\":\"recipe_set_name\"},{\"type\":\"string\",\"name\":\"region\"},{\"type\":\"string\",\"name\":\"season\"},{\"type\":\"string\",\"name\":\"route_reason\"},{\"type\":\"string\",\"name\":\"micro_adjustment_tags\"},{\"type\":\"string\",\"name\":\"rule_version\"}]}},{\"id\":\"200104A\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":5240,\"y\":514.9}},\"data\":{\"nodeMeta\":{\"title\":\"生成28天单日食谱\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"profile_json\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200101\",\"name\":\"profile_json\"},\"rawMeta\":{\"type\":6}}}},{\"name\":\"report_json\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"105094\",\"name\":\"report\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"recipe_set_id\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200102\",\"name\":\"recipe_set_id\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"micro_adjustment_tags\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200102\",\"name\":\"micro_adjustment_tags\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"item1\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200104A\",\"name\":\"item1\"},\"rawMeta\":{\"type\":6}}}}],\"llmParam\":[{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"default_val\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.3\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTokens\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"4096\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"topP\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.7\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"responseFormat\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"2\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"modleName\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"Deepseek-V4-Flash-VolcEngine\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"modelType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"280\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"supportThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"enableThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"当天基础食谱：\\n{{item1}}\\n\\n用户结构化信息：\\n{{profile_json}}\\n\\n体检报告摘要：\\n{{report_json}}\\n\\n当前套系：\\n{{recipe_set_id}}\\n\\n微调标签：\\n{{micro_adjustment_tags}}\\n\\n请严格输出以下 JSON（只输出一个 JSON 对象，不要输出数组、Markdown 围栏或解释文字）：\\n{\\n  \\\"day_no\\\": 1,\\n  \\\"dayLabel\\\": \\\"Day1（周一）\\\",\\n  \\\"meals\\\": {\\n    \\\"MORNING\\\": \\\"\\\",\\n    \\\"BREAKFAST\\\": \\\"\\\",\\n    \\\"LUNCH\\\": \\\"\\\",\\n    \\\"DINNER\\\": \\\"\\\"\\n  },\\n  \\\"usedIngredients\\\": [],\\n  \\\"adjustmentNotes\\\": []\\n}\\n\\n要求：\\n1. day_no 和 dayLabel 必须根据当天基础食谱中的实际日期生成，不要固定输出 Day1。当前是第几个批处理项就生成第几天。\\n2. MORNING、BREAKFAST、LUNCH、DINNER 必须有内容。\\n3. 每个食材尽量保留克数或数量。\\n4. 只输出 JSON，不要 Markdown 代码块、不要解释。\\n5. 不要输出除上述字段以外的任何内容。\\n6. 字段名必须与示例完全一致（usedIngredients 的 I 大写、adjustmentNotes 的 N 大写），不要改名或增删字段。\\n7. 所有字符串值使用双引号，JSON 必须可被 json.loads 解析。\\n8. meals 内每餐内容必须以 ▶ 开头逐行列出并保留换行，严禁输出 Markdown 标题（如 #### **早餐**），严禁用分号或顿号把多条食材合并成一行。\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"enableChatHistory\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":false,\"rawMeta\":{\"type\":3}}}},{\"name\":\"chatHistoryRound\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"3\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"systemPrompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"你是具备慢病临床营养调理经验的专业营养师，核心任务是基于给定的「基础单日食谱」，结合用户身体画像（慢病、过敏、食物不耐受、饮食禁忌、体重情况、就餐场景），生成适配该用户的个性化单日食谱，严格遵循以下规则，优先级从高到低：\\n\\n### 一、核心红线规则（违反即错误）\\n1. 严格保留基础食谱原有餐次结构（早餐/午餐/晚餐/加餐等）、各餐对应食材克重；所有食材替换必须遵循「同品类、等重量、营养等价」原则，不得随意增减分量、改动餐次。\\n2. 严禁引入用户明确标注的过敏、忌口、不耐受食材；替换后的食材不得触发用户任意一项病症禁忌。\\n3. 所有调整必须符合临床营养规范，不得违背对应慢病的饮食管控原则。\\n\\n### 二、重复规避规则（严格执行，降低周食谱重复率）\\n1. 周维度管控：同一餐次（如每周一午餐）内，食材重复率不得超过20%，禁止连续出现同一种主菜、主食。\\n2. 同食材不同形态判定为重复：番茄/圣女果、土豆/土豆片/土豆丝、豆腐/豆干/腐竹、大米/米粥、白菜/娃娃菜等均视为同一食材，同餐、同日不得高频出现，周内同餐次避免重复。\\n3. 同餐同类禁重复：同一餐内禁止出现同大类食材叠加，如大豆制品（豆腐+腐竹+豆干）、菌菇类（香菇+平菇+金针菇）不得在同一餐出现2种及以上。\\n\\n### 三、分人群精准替换细则\\n#### （一）慢病类\\n1. 糖尿病/血糖偏高\\n- 所有粥类、稀饭、汤泡饭一律替换为同等重量的干制主食；大幅减少浓汤、勾芡菜品，优先清炒、清蒸、炖煮\\n- 主食优先选用低GI食材，精制米面替换为杂粮杂豆混合主食\\n- 健康引导：提醒细嚼慢咽，遵循「蔬菜→蛋白→主食」的进食顺序，餐后半小时适度活动\\n2. 高血压/钠摄入管控\\n- 全部移除腌制品、酱菜、腊味、加工肉制品，禁用酱油、蚝油、豆瓣酱等高钠调味料，改用葱姜蒜、香草、少量低钠盐调味\\n- 健康引导：告知每日食盐摄入量不超过5g，避开隐形高钠食物，优先选择新鲜天然食材\\n3. 高血脂/血脂异常\\n- 移除所有肥肉、动物皮、油炸食品、酥点、动物内脏，烹饪方式改为清蒸、清炒、炖煮、凉拌，严控单餐用油量\\n- 蛋白优先替换为低脂高蛋白食材（去皮禽肉、鱼虾、瘦牛里脊）\\n- 健康引导：说明每日健康用油量，兼顾Omega-3与单不饱和脂肪酸搭配，减少饱和脂肪摄入\\n4. 高尿酸/痛风\\n- 移除所有浓肉汤、火锅汤、动物内脏、贝类海鲜、高嘌呤菌菇；减少大豆制品、深海鱼的出现频次\\n- 禁用浓汤、老火汤，优先清汤、快汤\\n- 健康引导：提醒每日足量饮水，避开高嘌呤食物，急性期严格管控\\n5. 慢性胃炎/肠胃虚弱\\n- 移除粗纤维、粗糙、坚硬、过酸、过冷、辛辣刺激食材，降低粗粮占比\\n- 蔬菜替换为细嫩瓜茄类、嫩叶菜，主食替换为软烂易消化品类，蛋白选温和好吸收的\\n- 健康引导：提醒细嚼慢咽，少食多餐，避开刺激性食物\\n6. 甲状腺疾病（桥本/甲亢）\\n- 甲亢/桥本急性期：严格限制高碘食材（海带、紫菜、海藻类、加碘盐），海鱼替换为淡水鱼\\n- 健康引导：说明碘摄入管控要求，规律作息\\n\\n#### （二）过敏与饮食禁忌类\\n1. 鱼虾/海鲜过敏：所有鱼虾、海鲜类食材，按等重量替换为去皮鸡胸肉、瘦牛里脊、豆腐、鸡蛋（鸡蛋需排除过敏）\\n2. 其他食物过敏/不耐受：对应食材直接移除，按同品类、等重量、营养等价原则替换为安全食材\\n3. 素食/宗教忌口：严格遵循食材禁忌，动物蛋白替换为优质植物蛋白\\n\\n#### （三）体重管理类\\n1. 增重/BMI偏低/体重丢失\\n- 主食降低粗粮比例，提升精制米面占比，适当增加优质蛋白与健康油脂占比，提升总热量\\n- 健康引导：建议少量多餐，运动后及时加餐，保证热量盈余\\n2. 减重/超重\\n- 主食提升粗粮杂豆比例，降低精制碳水占比，增加高纤维蔬菜占比，严控油脂与添加糖\\n- 健康引导：提醒三餐定时定量，增加膳食纤维摄入，提升饱腹感\\n\\n#### （四）就餐场景适配（用户提供时执行）\\n1. 食堂就餐：食材替换为食堂常见品类，同步给出选餐指引\\n2. 外卖就餐：优先推荐清淡品类，给出外卖选择建议\\n3. 无烹饪条件：全部替换为可直接食用、简单冲泡的食材\\n\\n### 四、输出规范\\n仅输出标准JSON格式，不得输出任何解释、说明、Markdown格式、代码围栏\",\"rawMeta\":{\"type\":1}}}}],\"batch\":{\"batchEnable\":true,\"batchSize\":28,\"concurrentSize\":8,\"inputLists\":[{\"name\":\"item1\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"object\",\"schema\":[]},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200201\",\"name\":\"outputList\"},\"rawMeta\":{\"type\":103}}}}]},\"settingOnError\":{\"switch\":true,\"dataOnErr\":\"{\\n    \\\"day_recipe_json\\\": \\\"{\\\\\\\"day_no\\\\\\\": 1, \\\\\\\"dayLabel\\\\\\\": \\\\\\\"DayN（默认兜底）\\\\\\\", \\\\\\\"meals\\\\\\\": {\\\\\\\"MORNING\\\\\\\": \\\\\\\"温水200ml\\\\\\\", \\\\\\\"BREAKFAST\\\\\\\": \\\\\\\"生成失败，请重新生成\\\\\\\", \\\\\\\"LUNCH\\\\\\\": \\\\\\\"生成失败，请重新生成\\\\\\\", \\\\\\\"DINNER\\\\\\\": \\\\\\\"生成失败，请重新生成\\\\\\\"}, \\\\\\\"usedIngredients\\\\\\\": [], \\\\\\\"adjustmentNotes\\\\\\\": [\\\\\\\"该日食谱由兜底数据填充，请重新生成或手动调整\\\\\\\"]}\\\",\\n    \\\"reasoning_content\\\": \\\"该日 LLM 生成失败，已使用默认兜底食谱\\\",\\n    \\\"outputList\\\": [\\n        {}\\n    ]\\n}\",\"processType\":1,\"timeoutMs\":600000,\"singleTimeoutMs\":90000,\"retryTimes\":1,\"ext\":{\"backupLLmParam\":\"{\\\"temperature\\\":1,\\\"maxTokens\\\":4096,\\\"topP\\\":0.95,\\\"responseFormat\\\":2,\\\"modelName\\\":\\\"Doubao-Seed-2.0-pro\\\",\\\"modelType\\\":200,\\\"generationDiversity\\\":\\\"default_val\\\"}\"}}},\"outputs\":[{\"type\":\"list\",\"name\":\"outputList\",\"schema\":{\"type\":\"object\",\"schema\":[{\"type\":\"integer\",\"name\":\"day_no\"},{\"type\":\"string\",\"name\":\"dayLabel\"},{\"type\":\"object\",\"name\":\"meals\",\"schema\":[{\"type\":\"string\",\"name\":\"MORNING\"},{\"type\":\"string\",\"name\":\"BREAKFAST\"},{\"type\":\"string\",\"name\":\"LUNCH\"},{\"type\":\"string\",\"name\":\"DINNER\"}]},{\"type\":\"list\",\"name\":\"usedIngredients\",\"schema\":{\"type\":\"string\"}},{\"type\":\"list\",\"name\":\"adjustmentNotes\",\"schema\":{\"type\":\"string\"}},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"readonly\":true}]}}],\"version\":\"3\"}},{\"id\":\"200105\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":5700,\"y\":540.9}},\"data\":{\"nodeMeta\":{\"title\":\"校验单日食谱\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"outputList\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"object\",\"schema\":[{\"type\":\"integer\",\"name\":\"day_no\"},{\"type\":\"string\",\"name\":\"dayLabel\"},{\"type\":\"object\",\"name\":\"meals\",\"schema\":[{\"type\":\"string\",\"name\":\"MORNING\"},{\"type\":\"string\",\"name\":\"BREAKFAST\"},{\"type\":\"string\",\"name\":\"LUNCH\"},{\"type\":\"string\",\"name\":\"DINNER\"}]},{\"type\":\"list\",\"name\":\"usedIngredients\",\"schema\":{\"type\":\"string\"}},{\"type\":\"list\",\"name\":\"adjustmentNotes\",\"schema\":{\"type\":\"string\"}},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"readonly\":true}]},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200104A\",\"name\":\"outputList\"},\"rawMeta\":{\"type\":103}}}}],\"code\":\"import json\\nimport re\\n\\nREQUIRED_MEALS = [\\\"MORNING\\\", \\\"BREAKFAST\\\", \\\"LUNCH\\\", \\\"DINNER\\\"]\\n\\n\\ndef normalize_day_no(day_no, fallback):\\n    \\\"\\\"\\\"把各种 day_no 写法规范化为整数\\\"\\\"\\\"\\n    if isinstance(day_no, int):\\n        return day_no\\n    if isinstance(day_no, float):\\n        return int(day_no)\\n    try:\\n        return int(str(day_no).strip())\\n    except (TypeError, ValueError):\\n        pass\\n    m = re.search(r\\\"\\\\d+\\\", str(day_no))\\n    if m:\\n        return int(m.group())\\n    return fallback\\n\\n\\ndef parse_day_recipe_json(raw):\\n    \\\"\\\"\\\"清洗并解析 LLM 输出的 day_recipe_json，兼容 Markdown 围栏和多余文本\\\"\\\"\\\"\\n    if not isinstance(raw, str):\\n        return raw\\n    text = raw.strip()\\n    if text.startswith(\\\"```\\\"):\\n        text = text.strip(\\\"`\\\")\\n        if text.lower().startswith(\\\"json\\\"):\\n            text = text[4:]\\n        text = text.strip()\\n    start = text.find(\\\"{\\\")\\n    end = text.rfind(\\\"}\\\")\\n    if start >= 0 and end > start:\\n        text = text[start:end + 1]\\n    try:\\n        return json.loads(text)\\n    except Exception:\\n        # 尝试修复被截断的 JSON\\n        fixed = fix_truncated_recipe_json(text)\\n        if fixed is not None:\\n            return fixed\\n        raise\\n\\n\\ndef fix_truncated_recipe_json(text):\\n    \\\"\\\"\\\"修复 LLM 输出的被截断食谱 JSON\\\"\\\"\\\"\\n    text = text.strip()\\n\\n    # 场景 1：截断在 DINNER 字段或更后面，已有完整 MORNING/BREAKFAST/LUNCH/DINNER\\n    # 找到 DINNER 字段的结束位置，然后补全后续结构\\n    dinner_match = re.search(r'\\\"DINNER\\\"\\\\s*:\\\\s*\\\"([^\\\"]*)\\\"', text)\\n    if dinner_match:\\n        dinner_end = dinner_match.end()\\n        fixed = text[:dinner_end] + ', \\\"usedIngredients\\\": [], \\\"adjustmentNotes\\\": []}'\\n        try:\\n            return json.loads(fixed)\\n        except Exception:\\n            pass\\n\\n    # 场景 2：截断在某个字符串值中间，尝试用更通用的方式补全 meals 后结构\\n    # 找到 meals 对象中最后一个完整的 \\\"key\\\": \\\"value\\\"\\n    last_match = None\\n    for pattern in [r'\\\"([A-Z]+)\\\"\\\\s*:\\\\s*\\\"([^\\\"]*)\\\"', r'\\\"([A-Z]+)\\\"\\\\s*:\\\\s*\\\\[([^\\\\]]*)\\\\]']:\\n        for m in re.finditer(pattern, text):\\n            last_match = m\\n    if last_match and last_match.end() < len(text):\\n        fixed = text[:last_match.end()] + ', \\\"usedIngredients\\\": [], \\\"adjustmentNotes\\\": []}'\\n        try:\\n            return json.loads(fixed)\\n        except Exception:\\n            pass\\n\\n    return None\\n\\n\\ndef extract_raw_from_item(item):\\n    \\\"\\\"\\\"从上游 item 中提取食谱 raw，兼容包装结构和直接对象\\\"\\\"\\\"\\n    if not isinstance(item, dict):\\n        return item\\n    # 如果 item 本身就是食谱对象（包含 meals），直接返回\\n    if \\\"meals\\\" in item:\\n        return item\\n    # 优先取 day_recipe_json（JSON 字符串）\\n    if item.get(\\\"day_recipe_json\\\") not in (None, \\\"\\\"):\\n        return item.get(\\\"day_recipe_json\\\")\\n    # 尝试其他常见字段\\n    for key in [\\\"output\\\", \\\"result\\\", \\\"content\\\", \\\"data\\\"]:\\n        if item.get(key) not in (None, \\\"\\\"):\\n            return item.get(key)\\n    return None\\n\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    output_list = params.get(\\\"outputList\\\") or []\\n\\n    debug_logs = []\\n\\n    def log(step, info):\\n        debug_logs.append({\\\"step\\\": step, \\\"info\\\": info})\\n\\n    log(\\\"input_type\\\", {\\\"output_list_type\\\": type(output_list).__name__, \\\"is_list\\\": isinstance(output_list, list)})\\n\\n    # 兼容：参数声明为 string 时，Coze 会把上游 list 序列化为 JSON 字符串传入\\n    if isinstance(output_list, str):\\n        log(\\\"input_is_string\\\", {\\\"length\\\": len(output_list), \\\"preview\\\": output_list[:200]})\\n        try:\\n            output_list = json.loads(output_list)\\n            log(\\\"parsed_string\\\", {\\\"parsed_type\\\": type(output_list).__name__})\\n        except Exception as exc:\\n            log(\\\"parse_string_error\\\", {\\\"error\\\": str(exc)})\\n            output_list = []\\n    if not isinstance(output_list, list):\\n        log(\\\"input_not_list\\\", {\\\"type\\\": type(output_list).__name__})\\n        output_list = []\\n\\n    valid_days = []\\n    failed_days = []\\n    errors = []\\n\\n    for index, item in enumerate(output_list):\\n        item_type = type(item).__name__\\n        item_keys = list(item.keys()) if isinstance(item, dict) else None\\n        log(f\\\"item_{index}_start\\\", {\\\"item_type\\\": item_type, \\\"item_keys\\\": item_keys})\\n\\n        raw = extract_raw_from_item(item)\\n        raw_type = type(raw).__name__\\n        raw_preview = str(raw)[:300]\\n        log(f\\\"item_{index}_raw\\\", {\\\"raw_type\\\": raw_type, \\\"raw_preview\\\": raw_preview})\\n\\n        if raw in (None, \\\"\\\", {}):\\n            failed_days.append(index + 1)\\n            err = {\\n                \\\"index\\\": index + 1,\\n                \\\"error\\\": \\\"day_recipe_json 为空\\\",\\n                \\\"item_type\\\": item_type,\\n                \\\"item_keys\\\": item_keys,\\n            }\\n            errors.append(err)\\n            log(f\\\"item_{index}_empty\\\", err)\\n            continue\\n\\n        try:\\n            obj = parse_day_recipe_json(raw)\\n            log(f\\\"item_{index}_parsed\\\", {\\\"obj_type\\\": type(obj).__name__, \\\"keys\\\": list(obj.keys())[:20] if isinstance(obj, dict) else None})\\n\\n            if not isinstance(obj, dict):\\n                raise ValueError(\\\"不是有效的 JSON 对象，类型：\\\" + type(obj).__name__)\\n\\n            # 加固1：检测兜底/失败标记，防止\\\"假成功\\\"（dataOnErr 兜底或模型输出失败文案）\\n            raw_text = str(raw)\\n            if any(mark in raw_text for mark in [\\\"生成失败\\\", \\\"请重新生成\\\", \\\"默认兜底\\\"]):\\n                raise ValueError(\\\"检测到兜底/失败标记，视为生成失败\\\")\\n\\n            # 加固2：item 自带 isSuccess=false 时判失败\\n            if isinstance(item, dict) and item.get(\\\"isSuccess\\\") is False:\\n                raise ValueError(\\\"批处理项 isSuccess=false\\\")\\n\\n            # 加固3：强制使用批处理顺序编号，不信 LLM 输出的 day_no（防幻觉/兜底错号）\\n            day_no = index + 1\\n            obj[\\\"day_no\\\"] = day_no\\n\\n            day_label = obj.get(\\\"dayLabel\\\") or obj.get(\\\"day_label\\\") or \\\"\\\"\\n            # 优先用数据库记录的 day_label，保证与 day_no 对齐（防 4 节点残留标签错位）\\n            base_label = item.get(\\\"day_label\\\") if isinstance(item, dict) else None\\n            if base_label:\\n                day_label = base_label\\n            else:\\n                m = re.search(r\\\"\\\\d+\\\", str(day_label))\\n                if m and int(m.group()) != day_no:\\n                    day_label = f\\\"Day{day_no}\\\"\\n            obj[\\\"dayLabel\\\"] = day_label\\n\\n            meals = obj.get(\\\"meals\\\") or {}\\n            log(f\\\"item_{index}_meals\\\", {\\\"meals_type\\\": type(meals).__name__, \\\"meals_keys\\\": list(meals.keys()) if isinstance(meals, dict) else None})\\n\\n            missing = [k for k in REQUIRED_MEALS if k not in meals]\\n            if missing:\\n                raise ValueError(\\\"缺少餐次：\\\" + \\\",\\\".join(missing))\\n            if not meals.get(\\\"BREAKFAST\\\") or not meals.get(\\\"LUNCH\\\") or not meals.get(\\\"DINNER\\\"):\\n                raise ValueError(\\\"早餐、午餐或晚餐为空\\\")\\n\\n            valid_days.append(obj)\\n            log(f\\\"item_{index}_success\\\", {\\\"day_no\\\": day_no, \\\"day_label\\\": day_label})\\n        except Exception as exc:\\n            failed_days.append(index + 1)\\n            err = {\\n                \\\"index\\\": index + 1,\\n                \\\"error\\\": str(exc),\\n                \\\"item_type\\\": item_type,\\n                \\\"raw_type\\\": raw_type,\\n                \\\"raw_preview\\\": raw_preview,\\n            }\\n            errors.append(err)\\n            log(f\\\"item_{index}_error\\\", err)\\n\\n    ok = (len(valid_days) == 28) and (not failed_days)\\n    status = \\\"SUCCESS\\\" if ok else \\\"FAILED\\\"\\n    result = {\\n        \\\"status\\\": status,\\n        \\\"is_success\\\": ok,\\n        \\\"valid_days\\\": {\\\"items\\\": valid_days},\\n        \\\"failed_days\\\": \\\",\\\".join(str(x) for x in failed_days),\\n        \\\"errors\\\": {\\\"items\\\": errors},\\n        \\\"completed_days\\\": str(len(valid_days)),\\n        \\\"total_days\\\": \\\"28\\\",\\n        \\\"debug_logs\\\": {\\\"items\\\": debug_logs}\\n    }\\n    log(\\\"final_result\\\", {\\\"completed_days\\\": len(valid_days), \\\"failed_count\\\": len(failed_days)})\\n    return result\\n\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"status\"},{\"type\":\"object\",\"name\":\"valid_days\",\"schema\":[]},{\"type\":\"string\",\"name\":\"failed_days\"},{\"type\":\"object\",\"name\":\"errors\",\"schema\":[]},{\"type\":\"string\",\"name\":\"completed_days\"},{\"type\":\"string\",\"name\":\"total_days\"},{\"type\":\"boolean\",\"name\":\"is_success\"},{\"type\":\"object\",\"name\":\"debug_logs\",\"schema\":[]}]}},{\"id\":\"200105b\",\"type\":\"8\",\"meta\":{\"position\":{\"x\":6160,\"y\":527.9}},\"data\":{\"nodeMeta\":{\"title\":\"校验分支\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Condition-v2.jpg\",\"description\":\"连接多个下游分支，若设定的条件成立则仅运行对应的分支，若均不成立则只运行“否则”分支\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"选择器\"},\"inputs\":{\"branches\":[{\"condition\":{\"logic\":2,\"conditions\":[{\"operator\":11,\"left\":{\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200105\",\"name\":\"is_success\"}}}}}]}}]}}},{\"id\":\"200106\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":9380,\"y\":573.9}},\"data\":{\"nodeMeta\":{\"title\":\"整理28天结果\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"valid_days\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200108\",\"name\":\"valid_days\"},\"rawMeta\":{\"type\":6}}}},{\"name\":\"reportAnalysis\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"105094\",\"name\":\"reportAnalysis\"},\"rawMeta\":{\"type\":6}}}}],\"code\":\"import json\\n\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    days = params.get(\\\"valid_days\\\") or []\\n    ra = params.get(\\\"reportAnalysis\\\") or []\\n\\n    # 兼容：参数声明为 string 时，Coze 会把上游 object 序列化为 JSON 字符串传入\\n    if isinstance(days, str):\\n        try:\\n            days = json.loads(days)\\n        except Exception:\\n            days = []\\n    if isinstance(days, dict):\\n        days = days.get(\\\"items\\\") or days.get(\\\"list\\\") or []\\n    if not isinstance(days, list):\\n        days = []\\n\\n    # reportAnalysis 兼容字符串/对象\\n    if isinstance(ra, str):\\n        try:\\n            ra = json.loads(ra)\\n        except Exception:\\n            ra = []\\n    if isinstance(ra, dict):\\n        ra = ra.get(\\\"items\\\") or []\\n    if not isinstance(ra, list):\\n        ra = []\\n\\n    days = sorted(days, key=lambda x: int(x.get(\\\"day_no\\\", 0)))\\n    weeks = []\\n\\n    for week_number in range(1, 5):\\n        start = (week_number - 1) * 7\\n        week_days = []\\n        for day in days[start:start + 7]:\\n            # 输出白名单：只保留 MORNING/BREAKFAST/LUNCH/DINNER 四餐，\\n            # 上游多余字段一律过滤，保证输出结构恒定\\n            src_meals = day.get(\\\"meals\\\", {}) or {}\\n            meals_out = {k: src_meals.get(k, \\\"\\\") for k in (\\\"MORNING\\\", \\\"BREAKFAST\\\", \\\"LUNCH\\\", \\\"DINNER\\\")}\\n            week_days.append({\\n                \\\"dayLabel\\\": day.get(\\\"dayLabel\\\", \\\"\\\"),\\n                \\\"dayNumber\\\": int(day.get(\\\"day_no\\\", 0)),\\n                \\\"meals\\\": meals_out\\n            })\\n        weeks.append({\\\"weekNumber\\\": week_number, \\\"days\\\": week_days})\\n\\n    result = {\\\"reportAnalysis\\\": ra, \\\"weeks\\\": weeks}\\n    return {\\n        \\\"error_message\\\": \\\"\\\",\\n        \\\"result\\\": result,\\n        \\\"status\\\": \\\"COMPLETED\\\",\\n        \\\"total_days\\\": str(len(days))\\n    }\\n\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"error_message\"},{\"type\":\"string\",\"name\":\"status\"},{\"type\":\"object\",\"name\":\"result\",\"schema\":[]},{\"type\":\"string\",\"name\":\"total_days\"}]}},{\"id\":\"197436\",\"type\":\"43\",\"meta\":{\"position\":{\"x\":3860,\"y\":495.9}},\"data\":{\"inputs\":{\"databaseInfoList\":[{\"databaseInfoID\":\"7668315009742569472\"}],\"selectParam\":{\"condition\":{\"conditionList\":[[{\"name\":\"left\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"set_id\"}}},{\"name\":\"operation\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"EQUAL\"}}},{\"name\":\"right\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200102\",\"name\":\"recipe_set_id\"},\"rawMeta\":{\"type\":1}}}}],[{\"name\":\"left\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"version\"}}},{\"name\":\"operation\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"EQUAL\"}}},{\"name\":\"right\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"v2\",\"rawMeta\":{\"type\":1}}}}]],\"logic\":\"AND\"},\"orderByList\":[],\"limit\":100},\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"list\",\"name\":\"outputList\",\"schema\":{\"type\":\"object\",\"schema\":[]}},{\"type\":\"integer\",\"name\":\"rowNum\"}],\"nodeMeta\":{\"title\":\"查询数据\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icaon-database-select.jpg\",\"description\":\"从表获取数据，用户可定义查询条件、选择列等，输出符合条件的数据\",\"mainColor\":\"#F2B600\",\"subTitle\":\"查询数据\"}}},{\"id\":\"200201\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":4320,\"y\":540.9}},\"data\":{\"nodeMeta\":{\"title\":\"排序28天基础食谱\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"outputList\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"object\",\"schema\":[]},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"197436\",\"name\":\"outputList\"},\"rawMeta\":{\"type\":103}}}}],\"code\":\"async def main(args: Args) -> Output:\\n    params = args.params\\n    output_list = params.get(\\\"outputList\\\") or []\\n    if not isinstance(output_list, list):\\n        output_list = []\\n\\n    # 按 day_no 升序排序，保证批处理输入顺序 = Day1~28\\n    # 兼容 day_no 为 int/str/缺失 的情况\\n    def day_key(item):\\n        if isinstance(item, dict):\\n            v = item.get(\\\"day_no\\\")\\n            try:\\n                return int(v)\\n            except (TypeError, ValueError):\\n                return 9999\\n        return 9999\\n\\n    output_list = sorted(output_list, key=day_key)\\n    return {\\n        \\\"outputList\\\": output_list\\n    }\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"list\",\"name\":\"outputList\",\"schema\":{\"type\":\"object\",\"schema\":[]}}]}},{\"id\":\"200107\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":6620,\"y\":586.9}},\"data\":{\"nodeMeta\":{\"title\":\"筛选失败天\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"failed_days\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200105\",\"name\":\"failed_days\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"base_list\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"object\",\"schema\":[]},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200201\",\"name\":\"outputList\"},\"rawMeta\":{\"type\":103}}}}],\"code\":\"import json\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    failed_str = params.get(\\\"failed_days\\\") or \\\"\\\"\\n    base_list = params.get(\\\"base_list\\\") or []\\n\\n    # 解析失败天号\\n    failed = []\\n    for part in str(failed_str).split(\\\",\\\"):\\n        part = part.strip()\\n        if part.isdigit():\\n            failed.append(int(part))\\n\\n    # base_list 是 200201 排序后的 28 天基础食谱（已按 day_no 升序）\\n    if isinstance(base_list, str):\\n        try:\\n            base_list = json.loads(base_list)\\n        except Exception:\\n            base_list = []\\n    if not isinstance(base_list, list):\\n        base_list = []\\n\\n    # 按 day_no 建索引（基础食谱 item 带 day_no）\\n    by_day = {}\\n    for i, item in enumerate(base_list):\\n        if isinstance(item, dict):\\n            dn = item.get(\\\"day_no\\\")\\n            if dn is not None:\\n                try:\\n                    by_day[int(dn)] = item\\n                except Exception:\\n                    by_day[i + 1] = item\\n            else:\\n                by_day[i + 1] = item\\n        else:\\n            by_day[i + 1] = item\\n\\n    # 顺序保持失败天号的升序（批处理顺序 = 失败天顺序）\\n    retry_items = []\\n    for dn in failed:\\n        if dn in by_day:\\n            retry_items.append(by_day[dn])\\n        else:\\n            # 找不到对应基础食谱时传占位（codex 🟢7），带 day_no 供 LLM 参考\\n            retry_items.append({\\\"day_no\\\": dn})\\n\\n    # 空 failed 防御（codex 🟢6）：正常不会发生，兜底输出完整列表避免空批\\n    if not retry_items:\\n        retry_items = base_list\\n\\n    return {\\\"retry_items\\\": retry_items}\\n\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"list\",\"name\":\"retry_items\",\"schema\":{\"type\":\"object\",\"schema\":[]}}]}},{\"id\":\"200104B\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":7540,\"y\":560.9}},\"data\":{\"nodeMeta\":{\"title\":\"重生成失败天食谱\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"profile_json\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200101\",\"name\":\"profile_json\"},\"rawMeta\":{\"type\":6}}}},{\"name\":\"report_json\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"105094\",\"name\":\"report\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"recipe_set_id\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200102\",\"name\":\"recipe_set_id\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"micro_adjustment_tags\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200102\",\"name\":\"micro_adjustment_tags\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"item1\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200104B\",\"name\":\"item1\"},\"rawMeta\":{\"type\":6}}}}],\"llmParam\":[{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"1\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTokens\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"4096\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"topP\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.7\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"responseFormat\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"2\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"modleName\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"Deepseek-V4-Flash-VolcEngine\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"modelType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"280\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"default_val\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"supportThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"enableThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"当天基础食谱：\\n{{item1}}\\n\\n用户结构化信息：\\n{{profile_json}}\\n\\n体检报告摘要：\\n{{report_json}}\\n\\n当前套系：\\n{{recipe_set_id}}\\n\\n微调标签：\\n{{micro_adjustment_tags}}\\n\\n请严格输出以下 JSON（只输出一个 JSON 对象，不要输出数组、Markdown 围栏或解释文字）：\\n{\\n  \\\"day_no\\\": 1,\\n  \\\"dayLabel\\\": \\\"Day1（周一）\\\",\\n  \\\"meals\\\": {\\n    \\\"MORNING\\\": \\\"\\\",\\n    \\\"BREAKFAST\\\": \\\"\\\",\\n    \\\"LUNCH\\\": \\\"\\\",\\n    \\\"DINNER\\\": \\\"\\\"\\n  },\\n  \\\"usedIngredients\\\": [],\\n  \\\"adjustmentNotes\\\": []\\n}\\n\\n要求：\\n1. day_no 和 dayLabel 必须根据当天基础食谱中的实际日期生成，day_no 使用当天基础食谱的 day_no，不要使用批处理序号。\\n2. MORNING、BREAKFAST、LUNCH、DINNER 必须有内容。\\n3. 每个食材尽量保留克数或数量。\\n4. 只输出 JSON，不要 Markdown 代码块、不要解释。\\n5. 不要输出除上述字段以外的任何内容。\\n6. 字段名必须与示例完全一致（usedIngredients 的 I 大写、adjustmentNotes 的 N 大写），不要改名或增删字段。\\n7. 所有字符串值使用双引号，JSON 必须可被 json.loads 解析。\\n8. meals 内每餐内容必须以 ▶ 开头逐行列出并保留换行，严禁输出 Markdown 标题（如 #### **早餐**），严禁用分号或顿号把多条食材合并成一行。\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"enableChatHistory\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":false,\"rawMeta\":{\"type\":3}}}},{\"name\":\"chatHistoryRound\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"3\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"systemPrompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"你是具备慢病临床营养调理经验的专业营养师，核心任务是基于给定的「基础单日食谱」，结合用户身体画像（慢病、过敏、食物不耐受、饮食禁忌、体重情况、就餐场景），生成适配该用户的个性化单日食谱，严格遵循以下规则，优先级从高到低：\\n\\n### 一、核心红线规则（违反即错误）\\n1. 严格保留基础食谱原有餐次结构（早餐/午餐/晚餐/加餐等）、各餐对应食材克重；所有食材替换必须遵循「同品类、等重量、营养等价」原则，不得随意增减分量、改动餐次。\\n2. 严禁引入用户明确标注的过敏、忌口、不耐受食材；替换后的食材不得触发用户任意一项病症禁忌。\\n3. 所有调整必须符合临床营养规范，不得违背对应慢病的饮食管控原则。\\n\\n### 二、重复规避规则（严格执行，降低周食谱重复率）\\n1. 周维度管控：同一餐次（如每周一午餐）内，食材重复率不得超过20%，禁止连续出现同一种主菜、主食。\\n2. 同食材不同形态判定为重复：番茄/圣女果、土豆/土豆片/土豆丝、豆腐/豆干/腐竹、大米/米粥、白菜/娃娃菜等均视为同一食材，同餐、同日不得高频出现，周内同餐次避免重复。\\n3. 同餐同类禁重复：同一餐内禁止出现同大类食材叠加，如大豆制品（豆腐+腐竹+豆干）、菌菇类（香菇+平菇+金针菇）不得在同一餐出现2种及以上。\\n\\n### 三、分人群精准替换细则\\n#### （一）慢病类\\n1. 糖尿病/血糖偏高\\n- 所有粥类、稀饭、汤泡饭一律替换为同等重量的干制主食；大幅减少浓汤、勾芡菜品，优先清炒、清蒸、炖煮\\n- 主食优先选用低GI食材，精制米面替换为杂粮杂豆混合主食\\n- 健康引导：提醒细嚼慢咽，遵循「蔬菜→蛋白→主食」的进食顺序，餐后半小时适度活动\\n2. 高血压/钠摄入管控\\n- 全部移除腌制品、酱菜、腊味、加工肉制品，禁用酱油、蚝油、豆瓣酱等高钠调味料，改用葱姜蒜、香草、少量低钠盐调味\\n- 健康引导：告知每日食盐摄入量不超过5g，避开隐形高钠食物，优先选择新鲜天然食材\\n3. 高血脂/血脂异常\\n- 移除所有肥肉、动物皮、油炸食品、酥点、动物内脏，烹饪方式改为清蒸、清炒、炖煮、凉拌，严控单餐用油量\\n- 蛋白优先替换为低脂高蛋白食材（去皮禽肉、鱼虾、瘦牛里脊）\\n- 健康引导：说明每日健康用油量，兼顾Omega-3与单不饱和脂肪酸搭配，减少饱和脂肪摄入\\n4. 高尿酸/痛风\\n- 移除所有浓肉汤、火锅汤、动物内脏、贝类海鲜、高嘌呤菌菇；减少大豆制品、深海鱼的出现频次\\n- 禁用浓汤、老火汤，优先清汤、快汤\\n- 健康引导：提醒每日足量饮水，避开高嘌呤食物，急性期严格管控\\n5. 慢性胃炎/肠胃虚弱\\n- 移除粗纤维、粗糙、坚硬、过酸、过冷、辛辣刺激食材，降低粗粮占比\\n- 蔬菜替换为细嫩瓜茄类、嫩叶菜，主食替换为软烂易消化品类，蛋白选温和好吸收的\\n- 健康引导：提醒细嚼慢咽，少食多餐，避开刺激性食物\\n6. 甲状腺疾病（桥本/甲亢）\\n- 甲亢/桥本急性期：严格限制高碘食材（海带、紫菜、海藻类、加碘盐），海鱼替换为淡水鱼\\n- 健康引导：说明碘摄入管控要求，规律作息\\n\\n#### （二）过敏与饮食禁忌类\\n1. 鱼虾/海鲜过敏：所有鱼虾、海鲜类食材，按等重量替换为去皮鸡胸肉、瘦牛里脊、豆腐、鸡蛋（鸡蛋需排除过敏）\\n2. 其他食物过敏/不耐受：对应食材直接移除，按同品类、等重量、营养等价原则替换为安全食材\\n3. 素食/宗教忌口：严格遵循食材禁忌，动物蛋白替换为优质植物蛋白\\n\\n#### （三）体重管理类\\n1. 增重/BMI偏低/体重丢失\\n- 主食降低粗粮比例，提升精制米面占比，适当增加优质蛋白与健康油脂占比，提升总热量\\n- 健康引导：建议少量多餐，运动后及时加餐，保证热量盈余\\n2. 减重/超重\\n- 主食提升粗粮杂豆比例，降低精制碳水占比，增加高纤维蔬菜占比，严控油脂与添加糖\\n- 健康引导：提醒三餐定时定量，增加膳食纤维摄入，提升饱腹感\\n\\n#### （四）就餐场景适配（用户提供时执行）\\n1. 食堂就餐：食材替换为食堂常见品类，同步给出选餐指引\\n2. 外卖就餐：优先推荐清淡品类，给出外卖选择建议\\n3. 无烹饪条件：全部替换为可直接食用、简单冲泡的食材\\n\\n### 四、输出规范\\n仅输出标准JSON格式，不得输出任何解释、说明、Markdown格式、代码围栏\",\"rawMeta\":{\"type\":1}}}}],\"batch\":{\"batchEnable\":true,\"batchSize\":28,\"concurrentSize\":8,\"inputLists\":[{\"name\":\"item1\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"object\",\"schema\":[]},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200107\",\"name\":\"retry_items\"},\"rawMeta\":{\"type\":103}}}}]},\"settingOnError\":{\"switch\":true,\"dataOnErr\":\"{\\n    \\\"day_recipe_json\\\": \\\"{\\\\\\\"day_no\\\\\\\": 1, \\\\\\\"dayLabel\\\\\\\": \\\\\\\"DayN（默认兜底）\\\\\\\", \\\\\\\"meals\\\\\\\": {\\\\\\\"MORNING\\\\\\\": \\\\\\\"温水200ml\\\\\\\", \\\\\\\"BREAKFAST\\\\\\\": \\\\\\\"生成失败，请重新生成\\\\\\\", \\\\\\\"LUNCH\\\\\\\": \\\\\\\"生成失败，请重新生成\\\\\\\", \\\\\\\"DINNER\\\\\\\": \\\\\\\"生成失败，请重新生成\\\\\\\"}, \\\\\\\"usedIngredients\\\\\\\": [], \\\\\\\"adjustmentNotes\\\\\\\": [\\\\\\\"该日食谱由兜底数据填充，请重新生成或手动调整\\\\\\\"]}\\\",\\n    \\\"reasoning_content\\\": \\\"该日 LLM 生成失败，已使用默认兜底食谱\\\",\\n    \\\"outputList\\\": [\\n        {}\\n    ]\\n}\",\"processType\":1,\"timeoutMs\":300000,\"singleTimeoutMs\":60000,\"retryTimes\":1,\"ext\":{\"backupLLmParam\":\"{\\\"temperature\\\":1,\\\"maxTokens\\\":4096,\\\"topP\\\":0.95,\\\"responseFormat\\\":2,\\\"modelName\\\":\\\"Doubao-Seed-2.0-pro\\\",\\\"modelType\\\":200,\\\"generationDiversity\\\":\\\"default_val\\\"}\"}}},\"outputs\":[{\"type\":\"list\",\"name\":\"outputList\",\"schema\":{\"type\":\"object\",\"schema\":[{\"type\":\"integer\",\"name\":\"day_no\"},{\"type\":\"string\",\"name\":\"dayLabel\"},{\"type\":\"object\",\"name\":\"meals\",\"schema\":[{\"type\":\"string\",\"name\":\"MORNING\"},{\"type\":\"string\",\"name\":\"BREAKFAST\"},{\"type\":\"string\",\"name\":\"LUNCH\"},{\"type\":\"string\",\"name\":\"DINNER\"}]},{\"type\":\"list\",\"name\":\"usedIngredients\",\"schema\":{\"type\":\"string\"}},{\"type\":\"list\",\"name\":\"adjustmentNotes\",\"schema\":{\"type\":\"string\"}},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"readonly\":true}]}}],\"version\":\"3\"}},{\"id\":\"200108\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":8000,\"y\":540.9}},\"data\":{\"nodeMeta\":{\"title\":\"合并复检\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"valid_days\",\"input\":{\"type\":\"object\",\"schema\":[],\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"200105\",\"name\":\"valid_days\"},\"rawMeta\":{\"type\":6}}}},{\"name\":\"retry_list\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"object\",\"schema\":[{\"type\":\"integer\",\"name\":\"day_no\"},{\"type\":\"string\",\"name\":\"dayLabel\"},{\"type\":\"object\",\"name\":\"meals\",\"schema\":[{\"type\":\"string\",\"name\":\"MORNING\"},{\"type\":\"string\",\"name\":\"BREAKFAST\"},{\"type\":\"string\",\"name\":\"LUNCH\"},{\"type\":\"string\",\"name\":\"DINNER\"}]},{\"type\":\"list\",\"name\":\"usedIngredients\",\"schema\":{\"type\":\"string\"}},{\"type\":\"list\",\"name\":\"adjustmentNotes\",\"schema\":{\"type\":\"string\"}},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"read