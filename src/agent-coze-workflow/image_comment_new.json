t\\\": \\\"\\\",\\n            \\\"tags\\\": [],\\n            \\\"error_msg\\\": \\\"dimensions 必须是列表\\\"\\n        }\\n    \\n    # 验证每个 dimension 对象的结构\\n    for idx, dim in enumerate(params['dimensions']):\\n        # 检查必需字段（注意原格式中的拼写）\\n        if 'sorce' not in dim or 'dimension' not in dim or 'comment' not in dim:\\n            return {\\n                \\\"comment\\\": \\\"\\\",\\n                \\\"tags\\\": [],\\n                \\\"error_msg\\\": f\\\"dimensions[{idx}] 缺少必需字段 (sorce/dimension/comment)，可能AI输出的字段名称有误。\\\"\\n            }\\n        else:\\n            dim[\\\"sorce\\\"] = str(int(dim[\\\"sorce\\\"])*10) if int(dim[\\\"sorce\\\"]) < 10 else dim[\\\"sorce\\\"]\\n    \\n    result = {\\n        \\\"title\\\": params['title'],\\n        \\\"dimensions\\\": params['dimensions'],\\n        \\\"summary\\\": params['summary']\\n    }\\n    \\n    return {\\n        \\\"comment\\\": json.dumps(result, ensure_ascii=False),\\n        \\\"tags\\\": [],\\n        \\\"error_msg\\\": \\\"\\\"\\n    }\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"comment\"},{\"type\":\"list\",\"name\":\"tags\",\"schema\":{\"type\":\"string\"}},{\"type\":\"string\",\"name\":\"error_msg\"}]}},{\"id\":\"117515\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":2111.605422934675,\"y\":-2315.559370539435}},\"data\":{\"nodeMeta\":{\"title\":\"代码_1\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"comment\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"144180\",\"name\":\"comment\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"tags\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\"},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"144180\",\"name\":\"tags\"},\"rawMeta\":{\"type\":99}}}}],\"code\":\"import json\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    error_msg = \\\"\\\"\\n    comment = params.get(\\\"comment\\\",\\\"\\\")\\n    tags = params.get(\\\"tags\\\",[])\\n    \\n    if comment == \\\"\\\":\\n        error_msg = \\\"点评失败：comment内容为空\\\"\\n\\n    if not tags:\\n        tags = [\\\"IP老师修图点评\\\"]\\n\\n    if len(comment) > 800:\\n        return {\\n            \\\"comment\\\": \\\"\\\",\\n            \\\"tags\\\": [],\\n            \\\"error_msg\\\": \\\"点评字数超限，模型输出异常（通常是将思考内容混在了点评结果中），请重新生成点评。\\\"\\n        }\\n    else:\\n       return {\\n            \\\"comment\\\": json.dumps([comment], ensure_ascii=False) if not error_msg else \\\"\\\",\\n            \\\"tags\\\":  tags if not error_msg else [],\\n            \\\"error_msg\\\": error_msg\\n        }\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"comment\"},{\"type\":\"list\",\"name\":\"tags\",\"schema\":{\"type\":\"string\"}},{\"type\":\"string\",\"name\":\"error_msg\"}]}},{\"id\":\"178580\",\"type\":\"8\",\"meta\":{\"position\":{\"x\":-1696.0916582583295,\"y\":-1439.496713152629}},\"data\":{\"nodeMeta\":{\"title\":\"选择器\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Condition-v2.jpg\",\"description\":\"连接多个下游分支，若设定的条件成立则仅运行对应的分支，若均不成立则只运行“否则”分支\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"选择器\"},\"inputs\":{\"branches\":[{\"condition\":{\"logic\":2,\"conditions\":[{\"operator\":7,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"category\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"shoujisheying\",\"rawMeta\":{\"type\":1}}}}},{\"operator\":7,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"comment_prompt\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"修图课\",\"rawMeta\":{\"type\":1}}}}}]}},{\"condition\":{\"logic\":2,\"conditions\":[{\"operator\":7,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"category\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"shoujisheying\",\"rawMeta\":{\"type\":1}}}}},{\"operator\":7,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"comment_prompt\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"构图课\",\"rawMeta\":{\"type\":1}}}}}]}},{\"condition\":{\"logic\":2,\"conditions\":[{\"operator\":7,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"category\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"sheyingmeixue\",\"rawMeta\":{\"type\":1}}}}},{\"operator\":8,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"comment_prompt\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"段晓晖\",\"rawMeta\":{\"type\":1}}}}}]}}]}}},{\"id\":\"144180\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":743.7233868861344,\"y\":-2341.559370539435}},\"data\":{\"nodeMeta\":{\"title\":\"手摄前端IP老师修图点评\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\",\"assistType\":2},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"167497\",\"name\":\"images\"},\"rawMeta\":{\"type\":104,\"isVision\":true}}}}],\"llmParam\":[{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"default_val\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.8\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTokens\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"16384\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"topP\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.95\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"responseFormat\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"2\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"modleName\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"Doubao-Seed-2.0-lite\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"modelType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"201\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"supportThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"enableThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"apiType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"1\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"第一张是原图，第二张是修后图：\\n{{images}}\\n\\n请开始点评。\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"enableChatHistory\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":false,\"rawMeta\":{\"type\":3}}}},{\"name\":\"chatHistoryRound\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"3\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"systemPrompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"# 角色\\n你是一位资深且亲切的手机摄影助教，擅长用鼓励式、聊天式方式给初学者做修图课作业点评。你的语气温柔稳定，不严厉，表达自然。\\n这节课的作业是对一张人像图片进行修图。原图左侧有杂乱的墙壁，需要裁剪掉；人脸偏暗，需要局部调亮；左下角墙面偏亮，需要局部压暗。如果学员的修后图完成了这三处修改，说明对人像修图掌握得很好。\\n\\n# 你的任务\\n1、先判断用户是否上传了原图和修后图。\\n2、根据本节课的修图知识点对修后图进行点评。\\n\\n# 情况A：第2张图是拼图：输出提示，不做点评\\n先识别到第2张图片是否为拼图（多张图片拼接到一起，有明显的分界线），如果是则输出以下提示：\\n\\n“同学好，老师发现你上传的是拼接图片，不能进行点评。请重新上传人像图片。”\\n\\n情况A需要输出标签到tags字段中：\\\"拼图无法点评\\\"。\\n\\n# 情况B：两张图片为不相关的图片：输出提示，不做点评\\n如果第2张图不是拼接图，再判断和第1张是否为同一张照片的原图和修后图（即两张图片的主体、场景、内容完全不同或相似度低于30%），则输出以下提示：\\n\\n“同学好，老师刚刚要来点评你的作业，发现你提交的不是同一张照片的原图和修图后的对比图，你给老师发一下同一张照片修图前和修图后的对比，这样老师才能帮你点评哦。”\\n\\n情况B需要输出标签到tags字段中：\\\"无法点评\\\"。\\n\\n# 情况C：正常点评\\n如果识别到两张图片是同一张照片的原图和修后图，则进行点评，具体点评逻辑如下：\\n## 1、开场白\\n- 你要像真实老师一样开场，示例：“老师看到你提交的修图作品啦。\\\"\\n\\n## 2、给出夸赞或建议\\n人像修图的思路是：“先整体再局部”。先整体裁剪，整体调整光感，再对脸部调亮，最后局部压暗高光。\\n根据两张图片对比的具体情况，给出建议：\\n  - 裁剪：判断修后图的左侧杂乱的墙壁是否裁剪掉了，如果裁剪掉了就夸赞，否则建议裁剪。夸赞示例：“老师注意到你特意去掉了画面里杂乱的干扰物，让人物变得非常突出，这种'摄影做减法'的意识非常棒！”\\n  - 调整光感：判断修后图的整体光感是否调亮，如果画面亮度适中就夸赞，否则建议调亮光感。如果画面亮度明显过亮，建议降低光感，使画面更自然。\\n  - 调整脸部：判断修后图的脸部是否变亮，如果脸部更亮就夸赞，否则建议使用醒图的局部修改功能，调亮脸部。\\n  - 局部压暗高光：判断修后图的左下角墙面是否压暗，如果墙面更暗就夸赞，否则建议使用醒图的局部修改功能，压暗墙面。\\n\\n## 3、收尾鼓励\\n给予肯定，例如：“整体来说你已经掌握得很好啦”、“继续保持这份认真，效果一定会越来越好”、“期待你的下一次作品”。\\n\\n# 点评要求\\n- 情况A需要输出标签：\\\"拼图无法点评\\\"；情况B需要输出标签：\\\"无法点评\\\"；情况C需要输出标签：\\\"IP老师修图点评\\\"。\\n- 点评抓住重点即可，不要过度关注细节，因为学员都是小白，要多给鼓励多给情绪价值，不要吹毛求疵。\\n- 点评字数控制在300到400字。多用断句，避免过多使用长句。\\n- 评论要体现专业深度，又要通俗易懂，适合语音合成播放。\\n- 适当增加语气词，整个点评的语气词控制在4个以内，避免过多语气词显得不专业。\\n- 点评内容不要分段，输出结果为纯文本，不要markdown格式。\\n- 点评内容不要使用破折号，点评内容不要出现任何英文单词，例如get、very good等单词。\",\"rawMeta\":{\"type\":1}}}}],\"settingOnError\":{\"processType\":1,\"timeoutMs\":600000,\"singleTimeoutMs\":0,\"retryTimes\":1,\"ext\":{\"backupLLmParam\":\"{\\\"temperature\\\":0.6,\\\"maxTokens\\\":4096,\\\"topP\\\":0.95,\\\"responseFormat\\\":2,\\\"modelName\\\":\\\"Qwen3.6-Plus\\\",\\\"modelType\\\":220,\\\"generationDiversity\\\":\\\"default_val\\\",\\\"supportThinking\\\":true,\\\"enableThinking\\\":true}\"}}},\"outputs\":[{\"type\":\"string\",\"name\":\"comment\"},{\"type\":\"list\",\"name\":\"tags\",\"schema\":{\"type\":\"string\"}},{\"type\":\"string\",\"name\":\"reasoning_content\"}],\"version\":\"3\"}},{\"id\":\"167497\",\"type\":\"5\",\"meta\":{\"position\":{\"x\":-314.9264882164525,\"y\":-2144.0962189425495}},\"data\":{\"nodeMeta\":{\"title\":\"判断图片数量\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Code-v2.jpg\",\"description\":\"编写代码，处理输入变量来生成返回值\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"代码\"},\"inputs\":{\"inputParameters\":[{\"name\":\"category\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"category\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"comment_prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"comment_prompt\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"camp_id\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"camp_id\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\"},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"images\"},\"rawMeta\":{\"type\":99}}}}],\"code\":\"import json\\n\\nasync def main(args: Args) -> Output:\\n    params = args.params\\n    category = params[\\\"category\\\"]\\n    comment_prompt = params[\\\"comment_prompt\\\"]\\n    camp_id = params[\\\"camp_id\\\"]\\n    images = params[\\\"images\\\"]\\n\\n    # 手机摄影体验营修图课，且只有一张照片的情况下，添加IP老师的默认图片作为原图\\n    if \\\"shoujisheying\\\" in category and camp_id in [\\\"26611777\\\",\\\"69886911371\\\",\\\"104048403841\\\"] and \\\"修图课\\\" in comment_prompt and len(images) == 1:\\n        images.insert(0,\\\"https://xqd-pm.oss-cn-hangzhou.aliyuncs.com/linshi/RZMRNLWW-EHQE-YLSQ-1775648247903-VWJQ6OK2SD45.jpeg\\\")\\n    return {\\n        \\\"comment_prompt\\\":comment_prompt,\\n        \\\"images\\\":images\\n    }\",\"language\":3,\"settingOnError\":{\"processType\":1,\"timeoutMs\":60000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"comment_prompt\"},{\"type\":\"list\",\"name\":\"images\",\"schema\":{\"type\":\"string\"}}]}},{\"id\":\"165173\",\"type\":\"8\",\"meta\":{\"position\":{\"x\":1252.8507126220593,\"y\":-2328.559370539435}},\"data\":{\"nodeMeta\":{\"title\":\"选择器_2\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Condition-v2.jpg\",\"description\":\"连接多个下游分支，若设定的条件成立则仅运行对应的分支，若均不成立则只运行“否则”分支\",\"mainColor\":\"#00B2B2\",\"subTitle\":\"选择器\"},\"inputs\":{\"branches\":[{\"condition\":{\"logic\":1,\"conditions\":[{\"operator\":8,\"left\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"144180\",\"name\":\"comment\"}}}},\"right\":{\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"拼接\",\"rawMeta\":{\"type\":1}}}}}]}}]}}},{\"id\":\"153640\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":743.7233868861344,\"y\":-2068.772565945504}},\"data\":{\"nodeMeta\":{\"title\":\"手机摄影前端修图点评\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"comment_prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"comment_prompt\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\",\"assistType