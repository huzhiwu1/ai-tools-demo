ut\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"outDocLink\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"\",\"rawMeta\":{\"type\":1}}}}],\"inputParameters\":[{\"name\":\"imageUrls\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\"},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"images\"},\"rawMeta\":{\"type\":99}}}},{\"name\":\"text\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"178504\",\"name\":\"output\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"type\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"gemini-3-flash-preview\",\"rawMeta\":{\"type\":1}}}}],\"settingOnError\":{\"switch\":true,\"dataOnErr\":\"{\\n    \\\"aboutUrl\\\": \\\"\\\",\\n    \\\"errorMessage\\\": \\\"\\\",\\n    \\\"billingDescription\\\": \\\"\\\",\\n    \\\"code\\\": 0,\\n    \\\"cost\\\": 0,\\n    \\\"data\\\": {\\n        \\\"text\\\": \\\"无\\\",\\n        \\\"model\\\": \\\"\\\",\\n        \\\"fileUrl\\\": \\\"\\\"\\n    },\\n    \\\"apiId\\\": \\\"\\\",\\n    \\\"traceId\\\": \\\"\\\"\\n}\",\"processType\":2,\"timeoutMs\":720000,\"singleTimeoutMs\":720000,\"retryTimes\":0}},\"outputs\":[{\"type\":\"string\",\"name\":\"aboutUrl\"},{\"type\":\"string\",\"name\":\"errorMessage\"},{\"type\":\"string\",\"name\":\"billingDescription\"},{\"type\":\"integer\",\"name\":\"code\"},{\"type\":\"float\",\"name\":\"cost\"},{\"type\":\"object\",\"name\":\"data\",\"schema\":[{\"type\":\"string\",\"name\":\"text\"},{\"type\":\"string\",\"name\":\"model\"},{\"type\":\"string\",\"name\":\"fileUrl\"}]},{\"type\":\"string\",\"name\":\"apiId\"},{\"type\":\"string\",\"name\":\"traceId\"},{\"type\":\"object\",\"name\":\"errorBody\",\"schema\":[{\"type\":\"string\",\"name\":\"errorMessage\",\"readonly\":true},{\"type\":\"string\",\"name\":\"errorCode\",\"readonly\":true}],\"readonly\":true},{\"type\":\"boolean\",\"name\":\"isSuccess\",\"readonly\":true}]}},{\"id\":\"1841111\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":400.0993967054952,\"y\":-1642.9302685183634}},\"data\":{\"nodeMeta\":{\"title\":\"构图识别_1\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\",\"assistType\":2},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"images\"},\"rawMeta\":{\"type\":104,\"isVision\":true}}}}],\"llmParam\":[{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"1\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTokens\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"16384\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"topP\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.95\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"responseFormat\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"2\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"modleName\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"Doubao-Seed-2.0-mini\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"modelType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"202\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"default_val\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"supportThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"enableThinking\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":true,\"rawMeta\":{\"type\":3}}}},{\"name\":\"apiType\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"1\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"这是图片：\\n{{images}}\\n\\n请开始识别。\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"enableChatHistory\",\"input\":{\"type\":\"boolean\",\"value\":{\"type\":\"literal\",\"content\":false,\"rawMeta\":{\"type\":3}}}},{\"name\":\"chatHistoryRound\",\"input\":{\"type\":\"integer\",\"value\":{\"type\":\"literal\",\"content\":\"3\",\"rawMeta\":{\"type\":2}}}},{\"name\":\"systemPrompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"# 任务\\n判断这张图片是什么构图，从：倒影对称构图、左右对称构图、对角线构图、三分法构图、居中构图、引导线构图6种中选一种。\\n\\n# 主体判断：\\n视觉主体是一个整体，例如画面中有花，花上面有蜜蜂，如果不是对蜜蜂进行特写，那么花就是视觉主体。\\n摄影作品中，主体可能有一个或多个，当然有的作品中也可能找不到明确主体。如果主体不明确，就无法判断构图类型，可以直接输出“无法确定构图”。\\n\\n# 构图判定优先级与逻辑\\n## 左右对称构图（P1）： \\n- 对于建筑，优先判断是否左右对称，如果对称则输出“左右对称构图”。左右对称构图的要求是建筑主体在画面垂直中轴线上。\\n- 若不对称，再看是否符合三分法构图或者居中构图。\\n## 对角线构图（P2）：\\n- 定义：画面主体只有一个，如果主体的轮廓或主要结构线形成了一个从画面一侧指向另一侧对角区域的倾斜坡度（坡度通常在 30° 至 60° 之间），且这种倾斜感是画面的核心视觉特征，则判定为：对角线构图。\\n## 三分法构图判定（P3）： \\n- 若画面有两个明显主体且分布在对角线上，判定为：三分法构图。\\n- 若主体是静物或人物，并且主体明确避开了中心区域，刻意放置在画面的左 1/3 或右 1/3 处 或者 上 1/3 或下 1/3 处，判定为：三分法构图。\\n- 如果画面是风景或建筑这种大场景的照片，先识别主体是什么，例如山是主体，并且山这个主体占画面三分之二，而天空占画面三分之一，那么判断为：三分法构图。\\n- 只要主体明显偏离中轴线，要考虑拍摄者可能是为了避开死板的居中，拍摄者可能想要三分构图，只是没有将主体完全放在三分线上。\\n## 倒影对称构图（P4）:\\n- 如果画面是室外风景照并且存在水面，需要判断画面的主体轮廓是否完整倒映在水面上，并且倒影细节清晰可见，才算是倒影对称构图。\\n- 如果主体是静物，且存在镜面，只要画面出现倒影（无论是否标准），直接输出：倒影对称构图。\\n## 居中构图判定（P5）： \\n- 定义：主体的整体轮廓（Bounding Box）大致位于画面中央区域，主体在画面中必须是上下左右都居中（允许 5% 以内的视觉偏移），才可以视为居中构图。\\n- 如果拍摄的主题是花，要特别注意花朵才是视觉主体，不包括花朵周围的枝叶。\\n## 引导线构图判断（P6）：\\n- 主体在画面中存在引导线，但是引导线构图的核心不是有线条就行，而是线条必须服务于主体，引导线的终点必须有视觉锚点。\\n## 模糊情况处理： \\n- 如果图片找不到明确主体，很难分析是什么构图，输出”无法确定构图“。\\n\\n构图判定时按照优先级进行判断，P1优先级最高，P6优先级最低。\\n\\n# 输出要求\\n仅输出标签名称和主体，例如：居中构图、建筑\",\"rawMeta\":{\"type\":1}}}}],\"settingOnError\":{\"processType\":1,\"timeoutMs\":600000,\"singleTimeoutMs\":0,\"retryTimes\":1,\"ext\":{\"backupLLmParam\":\"{\\\"temperature\\\":0.6,\\\"maxTokens\\\":4096,\\\"topP\\\":0.95,\\\"responseFormat\\\":2,\\\"modelName\\\":\\\"Qwen3.6-Plus\\\",\\\"modelType\\\":220,\\\"generationDiversity\\\":\\\"default_val\\\",\\\"supportThinking\\\":true,\\\"enableThinking\\\":true}\"}}},\"outputs\":[{\"type\":\"string\",\"name\":\"regconize_tag\"}],\"version\":\"3\"}},{\"id\":\"1224734\",\"type\":\"3\",\"meta\":{\"position\":{\"x\":1747.085096384453,\"y\":-1293.8991857094813}},\"data\":{\"nodeMeta\":{\"title\":\"手摄前端构图点评_1\",\"icon\":\"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg\",\"description\":\"调用大语言模型,使用变量和提示词生成回复\",\"mainColor\":\"#5C62FF\",\"subTitle\":\"大模型\"},\"inputs\":{\"inputParameters\":[{\"name\":\"comment_prompt\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"comment_prompt\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"recognize_tag\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"1841111\",\"name\":\"regconize_tag\"},\"rawMeta\":{\"type\":1}}}},{\"name\":\"images\",\"input\":{\"type\":\"list\",\"schema\":{\"type\":\"string\",\"assistType\":2},\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"100001\",\"name\":\"images\"},\"rawMeta\":{\"type\":104,\"isVision\":true}}}},{\"name\":\"tags\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"ref\",\"content\":{\"source\":\"block-output\",\"blockID\":\"1037879\",\"name\":\"tag\"},\"rawMeta\":{\"type\":1}}}}],\"llmParam\":[{\"name\":\"generationDiversity\",\"input\":{\"type\":\"string\",\"value\":{\"type\":\"literal\",\"content\":\"default_val\",\"rawMeta\":{\"type\":1}}}},{\"name\":\"temperature\",\"input\":{\"type\":\"float\",\"value\":{\"type\":\"literal\",\"content\":\"0.8\",\"rawMeta\":{\"type\":4}}}},{\"name\":\"maxTo