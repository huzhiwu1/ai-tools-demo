# ============================================
# LLM 网关配置（dachensky 网关，OpenAI 兼容）
# ============================================
# 网关 key 已失效（401 invalid credentials），注释后回退到官方 DeepSeek（DEEPSEEK_*）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ============================================
# DeepSeek API 配置（直连，备用）
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Coze 平台配置（私有部署）
# COZE_SESSION_KEY 是登录后从 cookie 里拿的 session_key（约 214 字符）
# 注意：不要填完整 cookie，只填 session_key 的值
# ============================================
COZE_API_BASE_URL=https://coze.dev1.dachensky.com
COZE_SPACE_ID=
COZE_SESSION_KEY=
# ============================================
# 服务端口
# ============================================
API_PORT=3000
WEB_PORT=5173

# ============================================
# 日志级别（debug | info | warn | error）
# ============================================
LOG_LEVEL=info