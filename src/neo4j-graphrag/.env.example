# ============================================
# Neo4j GraphRAG 环境配置
# ============================================

# --- LLM 配置 ---
# API Key（必填）：你的大模型 API Key
OPENAI_API_KEY=sk-your-api-key-here

# API Base URL（必填）：兼容 OpenAI 格式的接口地址
# 阿里百炼（通义千问）示例：
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（必填）：要使用的模型
MODEL_NAME=qwen-plus

# --- Neo4j 配置 ---
# Neo4j Bolt 协议地址（默认本地 Docker）
NEO4J_URI=bolt://localhost:7687

# Neo4j 用户名（默认 neo4j）
NEO4J_USER=neo4j

# Neo4j 密码（docker-compose 中配置的初始密码）
NEO4J_PASSWORD=12345678
