# ============================================================
# AI 模型配置（兼容 OpenAI 协议的任意厂商均可，例如：通义千问 / DeepSeek / Kimi）
# ============================================================
# 本项目复用根目录 .env 的命名（API_KEY / BASE_URL / MODEL_NAME），
# 也可用 OpenAI 官方命名（OPENAI_API_KEY / OPENAI_BASE_URL）。
# 两套都支持，二选一即可。

API_KEY=sk-xxx
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 服务端口（可选，默认 3000）
PORT=3000
